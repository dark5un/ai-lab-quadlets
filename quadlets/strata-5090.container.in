# Strata variant: RTX 5090 32 GB, 256K context.
# Rendered by scripts/install-strata.sh (GPU UUIDs filled in from nvidia-smi).
# One strata variant (strata-5090, -5090-524k, -5090-1m, -4070ti, -4070ti-524k,
# -4070ti-1m, -both) runs at
# a time: they share the container name (clients use http://systemd-strata:8080)
# and host port 11434, and Conflicts= makes systemd stop the running one first.
# strata-coder (4070 Ti, :11439) may run beside a 5090 variant ("duo").
# Strata owns its card(s). Use `ai-lab` / the bar widget to start GPU services:
# scripts/gpu-arbiter.py moves strata or ComfyUI to the other card. Conflicts=
# below is only the backstop for a bare `systemctl start`, which STOPS the
# other side instead of moving it (Conflicts= works in both directions).
# No [Install]: nothing starts at boot; switch with `ai-lab strata 5090` or the
# AI Lab bar widget.

[Unit]
Description=Strata Qwen model server (RTX 5090 32 GB, 256K context)
Wants=ai-network.service
After=ai-network.service
Conflicts=maya-5090-256.service maya-5090-512.service maya-5090-1024.service maya-both-256.service maya-both-512.service maya-both-1024.service comfyui-5090.service llama-cpp-5090.service llama-cpp-both.service strata-4070ti-1m.service strata-4070ti-524k.service strata-4070ti.service strata-5090-1m.service strata-5090-524k.service strata-both.service
StartLimitIntervalSec=20min
StartLimitBurst=2

[Container]
ContainerName=systemd-strata
Image=localhost/strata-harness:multi
Network=ai.network
# The container sees only the card(s) below, so nvidia-smi and CUDA agree on
# the numbering inside it; GPU=0 is that card.
AddDevice=nvidia.com/gpu=__GPU_5090_UUID__
SecurityLabelDisable=true
# Pinned to the CPUs left free for strata-coder (render-units.sh fills them in:
# all but the last 8). Setup's --pool-workers (15 here) must stay below the
# pinned core count: workers == cores halves decode (spin-waiting workers).
Entrypoint=/usr/bin/taskset
Exec=-c __CPUS_MAIN__ /opt/strata/entrypoint.sh run
# Shared settings + API key (FAMILY, MODEL, VISION, API_KEY).
EnvironmentFile=%h/.config/containers/config/strata/service.env
Environment=PRESET=strata-5090
Environment=MODEL_PATH=/data/models/IQ3_S
Environment=PARALLEL=2
# Per-variant settings. The 0.2.0 image saves these choices as the preset
# named in PRESET= (under /data/config = config-<v>); delete that preset to
# re-run setup, or change a value here and it re-saves on the next start.
Environment=GPU=0
Environment=CONTEXT=262144
Environment=KV=int8
# Model data is shared by all variants; the setup config is per variant.
Volume=%h/.local/share/strata/models:/data/models:z
Volume=%h/.local/share/strata/mtp:/data/mtp:z
Volume=%h/.local/share/strata/packs:/data/packs:z
# strata-harness fork: the agent tab at /harness (serve/harness); sessions
# and spill live on a shared state volume (same layout as the host CLI).
Environment=STRATA_HARNESS=1
Environment=STRATA_HARNESS_DIR=/data/harness
# M9: new sessions default to the shared workspaces tree (the
# harness tab's trusted-folder fence; pick per-session roots to override).
Environment=STRATA_HARNESS_ROOTS=/data/workspaces
# ADR-0014: the harness Plugins panel + loader are on; a plugin file is
# imported ONLY after its sha256 is reviewed (panel or /harness/plugins/review).
# The plugin dir lives on the shared harness state volume.
Environment=STRATA_HARNESS_PLUGINS=1
Environment=STRATA_HARNESS_PLUGIN_DIR=/data/harness/plugins
Volume=%h/.local/share/strata/harness:/data/harness:Z
# M9 trusted workspaces: the agent tab's per-session trusted folders live
# here — place project dirs into this tree to share them with a session.
Volume=%h/.local/share/strata/workspaces:/data/workspaces:Z
Volume=%h/.local/share/strata/Strata-data:/data/Strata-data:Z
Volume=%h/.local/share/strata/config-5090:/data/config:Z
Volume=%h/.local/share/strata/state:/data/state:Z
Volume=%h/.local/share/strata/install:/data/install:Z
Volume=%h/.local/share/strata/home:/data/home:Z
PublishPort=0.0.0.0:11434:8080/tcp

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=30
TimeoutStartSec=3600
TimeoutStopSec=120
