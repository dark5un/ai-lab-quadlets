# s3-webdav: exposes every Garage bucket as a WebDAV tree (rclone serve
# webdav over the `garage:` S3 remote) — doc-inbox/, doc-summaries/ and
# ci-artifacts/ appear as folders, same browsing story as the dufs
# whole-home share but for object-storage state ("as other integrations do").
# Exposure: TAILNET ONLY. Loopback bind 3124; tailscale serve terminates
# TLS on :8449 and proxies to it (dufs pattern). Auth: one basic-auth
# account (webdav) via apr1 htpasswd in config/s3-webdav/ (generated by
# scripts/generate-secrets.sh; plaintext mirror in service.env).
# The remote's S3 credentials mirror s3/service.env — no separate key.
# Boots with the session (files tier, dufs precedent: headless-box access
# must never gap).

[Unit]
Description=S3 WebDAV front (rclone serve webdav over Garage buckets)
Wants=ai-network.service
After=ai-network.service
Wants=s3.service
After=s3.service

[Container]
ContainerName=systemd-s3-webdav
# Tag reference here; the digest pin lives in services.json image_digest
# (dufs precedent — the consistency test forbids @sha in quadlets).
Image=docker.io/rclone/rclone:latest
Network=ai.network
PublishPort=127.0.0.1:3124:8080/tcp
EnvironmentFile=%h/.config/containers/config/s3-webdav/service.env
Volume=%h/.config/containers/config/s3-webdav:/cfg:ro,Z
Exec=serve webdav garage: --addr :8080 --htpasswd /cfg/htpasswd

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
