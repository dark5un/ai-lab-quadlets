# VS Code Server dev box (Arch) — image
#
# Build:
#   podman build -t localhost/vscode:1.144.1 -f containers/vscode/Containerfile containers/vscode/
#
# Official VS Code Server CLI pinned by commit. Update deliberately:
#   resolve https://update.code.visualstudio.com/latest/cli-linux-x64/stable, read commit from URL.
#
# uid/gid 1000 MUST match host px; quadlet runs with UserNS=keep-id.

# syntax=docker/dockerfile:1.7
FROM docker.io/library/archlinux@sha256:42217d5f09e11d3fe7ad3b309b7fde891d458464dab5d674e629073765610427

ARG VSCODE_COMMIT=261c84cb1eddf11235f9e2c921425e9663fbe556
# gcloud CLI pinned to the latest rapid release (verified live 2026-11-03).
# Update deliberately: probe
#   https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-<V>-linux-x86_64.tar.gz
# (or the latest google-cloud-cli entry in packages.cloud.google.com/apt).
ARG GCLOUD_VERSION=592.0.0

# Full -Syu first (digest-pinned base: never a partial upgrade).
# Starter package set is deliberately small; px installs the rest with sudo.
# mise is pacman-managed here exactly like on the host (2026.10.x).
# Cloud/forge CLIs: github-cli, glab, opentofu, aws-cli-v2 (provides `aws`)
# are all official extra repos. gcloud is NOT in Arch repos -> official
# Google tarball method below.
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm --needed \
      base-devel bash curl ca-certificates fish git jq mise neovim \
      openssh fd fzf procps-ng iproute2 ripgrep which \
      sudo podman \
      github-cli glab opentofu aws-cli-v2 \
      unzip zip tar gzip xz && \
    pacman -Sc --noconfirm

# Google Cloud CLI: official quickstart for generic Linux (docs verified
# 2026-11-03): download the x86_64 rapid tarball, extract, run install.sh
# non-interactively. The x86_64 package bundles its own Python interpreter
# (system python NOT required). gcloud component installs via `sudo gcloud
# components install X` change the container only -- bake extra components
# here (GCLOUD_VERSION bump) to make them permanent.
RUN curl -fL "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-${GCLOUD_VERSION}-linux-x86_64.tar.gz" \
      -o /tmp/gcloud.tar.gz && \
    tar -xzf /tmp/gcloud.tar.gz -C /opt && \
    rm /tmp/gcloud.tar.gz && \
    /opt/google-cloud-sdk/install.sh --quiet \
      --usage-reporting=false --command-completion=false --path-update=false && \
    ln -s /opt/google-cloud-sdk/bin/gcloud /usr/local/bin/gcloud && \
    gcloud --version | head -1

# fly (Concourse CLI) for the agentic pipeline (agentic-pipeline plan sec. 6).
# Pinned to the concourse-web server version (services.json 8.3.3) - fly and
# the ATC must match. Bump both together; asset names verified live via
# api.github.com/repos/concourse/concourse/releases/tags/v<X> (fly-<X>-linux-amd64.tgz).
RUN curl -fL "https://github.com/concourse/concourse/releases/download/v8.3.3/fly-8.3.3-linux-amd64.tgz" \
      -o /tmp/fly.tgz && \
    curl -fsSL "https://github.com/concourse/concourse/releases/download/v8.3.3/fly-8.3.3-linux-amd64.tgz.sha1" \
      -o /tmp/fly.sha1 && \
    echo "$(awk '{print $1}' /tmp/fly.sha1)  /tmp/fly.tgz" | sha1sum -c - && \
    tar -xzf /tmp/fly.tgz -C /usr/local/bin fly && \
    chmod 0755 /usr/local/bin/fly && rm /tmp/fly.tgz /tmp/fly.sha1

# Pipeline endpoints for the box's users (dotfile-style, in-network names):
#   git: http://systemd-forge:3000 (token) / ssh://git@<node-tailnet-fqdn>:2223
#   S3:  http://systemd-s3:3900 (region garage, path-style)
#   fly: -t ai http://systemd-concourse-web:8080
RUN printf '%s\n' \
    '# ai-lab pipeline endpoints (agentic-pipeline plan)' \
    'export PIPELINE_FORGE_URL=http://systemd-forge:3000' \
    'export PIPELINE_S3_ENDPOINT=http://systemd-s3:3900' \
    'export PIPELINE_CONCOURSE_URL=http://systemd-concourse-web:8080' \
    'export AWS_REGION=garage AWS_S3_ADDRESSING_STYLE=path' \
    > /etc/profile.d/ai-lab-pipeline.sh

# px = 1000:1000 (keep-id maps it to host px); fish is the login shell;
# wheel + NOPASSWD = distrobox-style sudo. The fish pacman hook registers
# /usr/bin/fish in /etc/shells, so useradd -s accepts it.
RUN groupadd -g 1000 px && \
    useradd -m -u 1000 -g 1000 -s /usr/bin/fish -G wheel px && \
    printf 'px ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/px && \
    chmod 0440 /etc/sudoers.d/px && \
    visudo -c

# VS Code Server CLI (single static-ish binary; glibc base, NOT the alpine build)
RUN curl -fL "https://update.code.visualstudio.com/commit:${VSCODE_COMMIT}/cli-linux-x64/stable" \
      -o /tmp/vscode-cli.tar.gz && \
    tar xzf /tmp/vscode-cli.tar.gz -C /usr/local/bin && \
    rm /tmp/vscode-cli.tar.gz && \
    /usr/local/bin/code --version

# Guest podman = client only (distrobox-style): every podman/docker-API call
# goes to the HOST daemon via the socket the quadlet mounts at the host's
# same path. remote=true makes bare `podman` pick the remote connection;
# the connection itself is registered once by the entrypoint into the
# persisted home (podman-connections.json). Do NOT export
# XDG_RUNTIME_DIR=/run/user/1000 here: the socket mount point is root-owned
# in the container and the client needs a writable runtime dir for its
# tmp files — with the var unset podman falls back to /tmp/storage-run-1000.
RUN mkdir -p /etc/containers && \
    printf '[engine]\nremote = true\n' > /etc/containers/containers.conf

# Strata model provider extension (stable LanguageModelChatProvider API).
# Baked into the image; the entrypoint installs it into the persisted
# ~/.vscode-server/extensions on start. See docs/copilot-strata.md.
COPY strata-provider/ /opt/vscode/extensions/strata-provider/

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

USER px:px
WORKDIR /home/px
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
