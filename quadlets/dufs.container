# dufs WebDAV file server: whole-home browse/edit for the Mac (Finder
# "Connect to Server" -> https://ai.<tailnet>.ts.net; no Mac-side installs
# needed). Exposure: TAILNET ONLY. Host bind is 127.0.0.1 so nothing reaches
# dufs over LAN in cleartext; `tailscale serve` terminates real TLS
# (Let's Encrypt cert) on 443 and proxies to this loopback port. The old
# ufw `allow 3112/tcp` LAN rule was deleted.
# Auth: basic, one account (px) with rw on the whole tree; the password lives
# sha-512-hashed in ~/.config/containers/config/dufs/config.yaml, generated by
# scripts/generate-secrets.sh, mounted read-only - never in argv or unit files.
# Container runs as 1000:1000 so web edits land owned by px.
# Boots with the session (files tier: holds no GPU, must not gap while the
# owner is away - see tests/test-quadlet-policy.sh).

[Unit]
Description=dufs WebDAV (whole home)
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-dufs
Image=docker.io/sigoden/dufs:latest
Network=ai.network
PublishPort=127.0.0.1:3112:5000/tcp
Volume=%h:/data
Volume=%h/.config/containers/config/dufs:/config:ro,Z
# Rootless podman maps container root to host uid 1000 (px): run at the
# default uid and uploads/web edits land owned by px. Do NOT add
# --user 1000:1000 here - that maps to subuid 100999 and breaks reads
# and ownership.
Exec=/data --config /config/config.yaml
RunInit=true

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
