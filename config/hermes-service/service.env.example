# Hermes Agent gateway service.env
# Fill in your own dashboard credentials.
# Generate secrets with: openssl rand -hex 32

HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me-to-a-random-hex-string
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change-me-to-another-random-hex-string

# Default model: local llama.cpp via internal network
# HERMES_DEFAULT_MODEL=<model-name>
# OPENAI_BASE_URL=http://systemd-llama-cpp:8080/v1
# OPENAI_API_KEY=no-key-required