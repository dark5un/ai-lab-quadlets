{
  "network": "systemd-ai",
  "services": [
    {
      "name": "llama-cpp-main",
      "unit": "llama-cpp-main.service",
      "container": "systemd-llama-cpp-main",
      "host_port": 11435,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/health",
      "tier": "core",
      "image": "ghcr.io/ggml-org/llama.cpp:server-cuda",
      "boot": true,
      "auth": "none",
      "image_digest": "ghcr.io/ggml-org/llama.cpp@sha256:e8318a7b3988f9ca57b28c03486569e60def08f2b7b060550ebfa046e175e6cb",
      "note": "open mode: no --api-key enforced (keys.txt is mounted but unused)"
    },
    {
      "name": "llama-cpp-research",
      "unit": "llama-cpp-research.service",
      "container": "systemd-llama-cpp-research",
      "host_port": 11436,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/health",
      "tier": "optional",
      "image": "ghcr.io/ggml-org/llama.cpp:server-cuda",
      "boot": false,
      "auth": "none",
      "image_digest": "ghcr.io/ggml-org/llama.cpp@sha256:e8318a7b3988f9ca57b28c03486569e60def08f2b7b060550ebfa046e175e6cb",
      "note": "open mode: no --api-key enforced (keys.txt is mounted but unused)"
    },
    {
      "name": "strata",
      "unit": "strata.service",
      "container": "systemd-strata",
      "host_port": 11434,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/health",
      "tier": "optional",
      "image": "localhost/strata:rtx5090",
      "boot": true,
      "auth": "api-key",
      "note": "port 11434 (Ollama-default slot), LAN bind (every request requires the API key); built from ~/workspace/github.com/Niko1221/Strata"
    },
    {
      "name": "open-webui",
      "unit": "open-webui.service",
      "container": "systemd-open-webui",
      "host_port": 3100,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/health",
      "tier": "web",
      "image": "ghcr.io/open-webui/open-webui:v0.11.3",
      "boot": true,
      "auth": "account",
      "image_digest": "ghcr.io/open-webui/open-webui@sha256:41daa0cf2561a5d4c8d1ff31ee2a98d93ab4d3ac2605cac69366ff6a3374a933"
    },
    {
      "name": "comfyui",
      "unit": "comfyui.service",
      "container": "systemd-comfyui",
      "host_port": 3101,
      "container_port": 8188,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "image",
      "image": "localhost/comfyui:v0.34.0-cu130",
      "boot": true,
      "auth": "none"
    },
    {
      "name": "sketchlab",
      "unit": "sketchlab.service",
      "container": "systemd-sketchlab",
      "host_port": 3102,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "web",
      "image": "localhost/sketchlab:v0.5.0",
      "boot": true,
      "auth": "none"
    },
    {
      "name": "hyperframes",
      "unit": "hyperframes.service",
      "container": "systemd-hyperframes",
      "host_port": 3103,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "video",
      "image": "localhost/hyperframes:latest",
      "boot": true,
      "auth": "none",
      "note": "built locally from ~/workspace/github.com/heygen-com/hyperframes at upstream commit f70dce7"
    },
    {
      "name": "hermes",
      "unit": "hermes.service",
      "container": "systemd-hermes",
      "host_port": 3104,
      "container_port": 9119,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "opt-in",
      "image": "docker.io/nousresearch/hermes-agent:latest",
      "boot": false,
      "auth": "account",
      "image_digest": "docker.io/nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db"
    },
    {
      "name": "deepseek-harness",
      "unit": "deepseek-harness.service",
      "container": "systemd-deepseek-harness",
      "host_port": 3105,
      "container_port": 3105,
      "bind": "127.0.0.1",
      "health": "/",
      "tier": "opt-in",
      "image": "localhost/deepseek-harness:0.1.2-rc.1",
      "boot": false,
      "auth": "token"
    }
  ]
}
