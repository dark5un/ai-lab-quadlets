# concourse-mcp — thin MCP server (streamable HTTP) over the Concourse ATC
# REST API (agentic-pipeline plan sec. 2.4/7). Built image:
# localhost/concourse-mcp (containers/concourse-mcp/Containerfile, uv-managed).
# One endpoint serves both consumers:
#   - Hermes on the host: PublishPort 127.0.0.1:3123
#   - Concourse task containers: in-network http://systemd-concourse-mcp:8080/mcp
# Bearer token -> Concourse team mapping lives in mcp.env (two tokens:
# Hermes-grade on team `pipeline`, low-privilege on team `agent`; abort_build
# and friends gated per token). No digests: built images carry no pin.

[Unit]
Description=Concourse MCP server (ATC REST bridge)
Wants=ai-network.service
Wants=concourse-web.service
After=ai-network.service
After=concourse-web.service

[Container]
ContainerName=systemd-concourse-mcp
Image=localhost/concourse-mcp:latest
Network=ai.network
EnvironmentFile=%h/.config/containers/config/concourse/mcp.env
PublishPort=127.0.0.1:3123:8080/tcp
# in-network only beyond loopback: task containers reach :8080 via aardvark

[Service]
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
