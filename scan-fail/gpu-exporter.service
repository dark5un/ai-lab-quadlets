ExecStart=/usr/bin/podman run --name systemd-gpu-exporter --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --security-opt label=disable --device nvidia.com/gpu=all --publish 127.0.0.1:9835:9835/tcp docker.io/utkuozdemir/nvidia_gpu_exporter@sha256:92a73ec03e2f5cae4a7cfcc99c242b46797741c24de8f3768d394925f8e0a323

