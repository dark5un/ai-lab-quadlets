# notebook service env (generated from this example; mode 600).
# Platform connection for every kernel (values for the *_KEY lines are
# mirrored at install time by install.sh from the owning services' secrets;
# the SERVER token is a separate file: jupyter-token, not env).
KB_ROUTER_URL=http://systemd-llama-cpp-4070ti:8080/v1
KB_ROUTER_KEY=
RAGFLOW_URL=http://systemd-ragflow:9380
RAGFLOW_API_KEY=
LIGHTRAG_URL=http://systemd-lightrag:9621
LIGHTRAG_API_KEY=
WM_URL=http://systemd-windmill-server:8000
WM_AGENT_TOKEN=
# marimo/uv sandbox mode uses uv from the image env; keep kernels light
MARIMO_SANDBOX_METHOD=venv
