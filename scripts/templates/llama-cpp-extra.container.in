# Additional GPU llama.cpp quadlet — GENERATED by scripts/detect-gpus.sh
# This file is re-generated on each install. Do not edit directly.
# Created when more than 2 NVIDIA GPUs are detected.

[Unit]
Description=llama.cpp {GPU_NAME} extra router
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=llama-cpp-extra-{INDEX}
Image=ghcr.io/ggml-org/llama.cpp:server-cuda

# GPU assignment: {GPU_NAME} ({GPU_VRAM} GB)
AddDevice=nvidia.com/gpu={GPU_UUID}
SecurityLabelDisable=true

Network=ai.network

# Native host clients:
# http://127.0.0.1:1{INDEX}43{INDEX}/v1
PublishPort=0.0.0.0:1{INDEX}43{INDEX}:8080

Volume=%h/.local/share/llama.cpp/models:/models:ro
Volume=%h/.config/containers/config/llama.cpp-extra-{INDEX}/presets.ini:/etc/llama-cpp/presets.ini:ro
Volume=%h/.config/containers/config/llama.cpp/keys.txt:/etc/llama-cpp/keys.txt:ro
EnvironmentFile=%h/.config/containers/config/llama.cpp-extra-{INDEX}/service.env

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
MemoryMax={MEMORY_MAX}G

[Install]
WantedBy=default.target