{
	auto_https disable_redirects
	skip_install_trust
}

https://HOSTNAME.local:3001 {
	tls internal

	# WebSocket-specific route — no security headers (they break the upgrade).
	# Open WebUI uses Socket.IO for real-time streaming.
	handle_path /ws/* {
		reverse_proxy open-webui:8080
	}

	# API and UI routes — apply security headers.
	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy open-webui:8080
}

https://HOSTNAME.local:3002 {
	tls internal

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy comfyui:8188
}

https://HOSTNAME.local:3003 {
	tls internal

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy hermes:9119
}

https://HOSTNAME.local:3004 {
	tls internal

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy sketchlab:8080
}

https://HOSTNAME.local:3005 {
	tls internal

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy deepseek-harness:3080
}