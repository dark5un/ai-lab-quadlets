{
  "uid": "ailab-overview",
  "title": "AI Lab Overview",
  "tags": ["ai-lab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(nvidia_smi_gpu_info, uuid)", "refId": "gpuVar" },
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Model server",
      "description": "Live strata model + context window",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "strata:engine_max_context", "format": "table", "instant": true }
      ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "ai_service": true }, "renameByName": { "model_name": "model", "Value": "context" } } } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "stat",
      "title": "Decode tok/s",
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "strata:live_tok_s" } ],
      "fieldConfig": { "defaults": { "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 50 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Prefill tok/s",
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "strata:live_prefill_tok_s_mean" } ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Expert cache hit",
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "strata:last_hit_rate" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Prefix cache hit",
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "rate(vllm:prefix_cache_hits_total[5m]) / clamp_min(rate(vllm:prefix_cache_queries_total[5m]), 1)" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Host RAM used",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "#EAB839", "value": 100000000000 }, { "color": "red", "value": 120000000000 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "What runs when (GPU services)",
      "description": "ailab:service_running from podman state + registry map. strata variants share a container: the live one is identified by the model/context stat above.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "ailab:service_running{service!~\".*exporter|prometheus|grafana|victorialogs|fluent-bit\"}", "legendFormat": "{{service}} {{gpu}}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 90, "spanNulls": false, "lineWidth": 0, "drawStyle": "line" }, "min": 0, "max": 2, "decimals": 0, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "nvidia_smi_utilization_gpu_ratio{uuid=~\"$gpu\"} / 100 * on(uuid) group_left(name) nvidia_smi_gpu_info", "legendFormat": "{{name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 15 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "GPU VRAM",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "nvidia_smi_memory_used_bytes{uuid=~\"$gpu\"} * on(uuid) group_left(name) nvidia_smi_gpu_info", "legendFormat": "{{name}} used" },
        { "refId": "B", "expr": "nvidia_smi_memory_total_bytes{uuid=~\"$gpu\"} * on(uuid) group_left(name) nvidia_smi_gpu_info", "legendFormat": "{{name}} total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 15 } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/ total$/" }, "properties": [ { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "dash": [4, 4], "fill": "dash" } } ] } ] }
    },
    {
      "type": "timeseries",
      "title": "GPU power and temperature",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "nvidia_smi_power_draw_watts{uuid=~\"$gpu\"} * on(uuid) group_left(name) nvidia_smi_gpu_info", "legendFormat": "{{name}} W" },
        { "refId": "B", "expr": "nvidia_smi_temperature_gpu{uuid=~\"$gpu\"} * on(uuid) group_left(name) nvidia_smi_gpu_info", "legendFormat": "{{name}} C" }
      ],
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 5 } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "/ C$/" }, "properties": [ { "id": "unit", "value": "celsius" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "min", "value": 0 }, { "id": "max", "value": 100 } ] },
        { "matcher": { "id": "byRegexp", "options": "/ W$/" }, "properties": [ { "id": "unit", "value": "watt" }, { "id": "min", "value": 0 } ] }
      ] }
    },
    {
      "type": "timeseries",
      "title": "Model throughput (tok/s, all servers)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[2m]))", "legendFormat": "decode {{model_name}}" },
        { "refId": "B", "expr": "sum by (model_name) (rate(vllm:prompt_tokens_total[2m]))", "legendFormat": "prompt {{model_name}}" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Requests and KV cache",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "vllm:num_requests_running", "legendFormat": "running {{ai_service}}" },
        { "refId": "B", "expr": "vllm:num_requests_waiting", "legendFormat": "waiting {{ai_service}}" },
        { "refId": "C", "expr": "vllm:kv_cache_usage_perc", "legendFormat": "kv {{ai_service}}" }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [ { "matcher": { "id": "byRegexp", "options": "/^kv/" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "min", "value": 0 }, { "id": "max", "value": 1 }, { "id": "custom.axisPlacement", "value": "right" } ] } ] }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (time to first token / inter-token)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "TTFT p95" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))", "legendFormat": "ITL p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Host: RAM and CPU",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "RAM used" },
        { "refId": "B", "expr": "node_memory_MemTotal_bytes", "legendFormat": "RAM total" },
        { "refId": "C", "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))", "legendFormat": "CPU busy" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [ { "matcher": { "id": "byName", "options": "CPU busy" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "min", "value": 0 }, { "id": "max", "value": 1 }, { "id": "custom.axisPlacement", "value": "right" } ] } ] }
    },
    {
      "type": "stat",
      "title": "Service health",
      "description": "blackbox probes; no data = service stopped (not failed)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "probe_success", "legendFormat": "{{ai_service}}" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "mappings": [ { "type": "value", "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "OK" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "name", "reduceOptions": { "calcs": ["lastNotNull"] }, "justifyMode": "auto" }
    },
    {
      "type": "timeseries",
      "title": "Container RAM (top 8)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "topk(8, podman_container_mem_usage_bytes * on(id) group_left(name) podman_container_info)", "legendFormat": "{{name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "logs",
      "title": "Container logs (VictoriaLogs)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "targets": [ { "refId": "A", "expr": "* | sort by (_time) desc", "maxLines": 200 } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "signature" }
    }
  ]
}
