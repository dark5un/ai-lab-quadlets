# Forgejo git forge (Codeberg e.V., GPL-3.0, v17.0.1) — agentic-pipeline plan.
# Git remotes for Concourse `git` resources. Repos/LFS/attachments persist in
# named volume forge-data (host container storage); DB = forge-postgres
# sidecar (no host port). Image pin (tag 17.0.1 == 17, index digest) lives in
# services.json image_digest; install.sh applies it to the deployed copy.
# All tailnet-specific values (ROOT_URL/DOMAIN/SSH_DOMAIN) live in
# config/forge/service.env (0600, generated on-target; never in this file —
# public repo, no real FQDNs).

[Unit]
Description=Forgejo git forge
Wants=ai-network.service
Wants=forge-postgres.service
After=ai-network.service
After=forge-postgres.service

[Container]
ContainerName=systemd-forge
Image=codeberg.org/forgejo/forgejo:17.0.1
Network=ai.network
# NO UserNS=keep-id here (verified live 2026-11-10): Forgejo 17's entrypoint
# must start as container-root (sed of /etc/passwd, mkdir /data/*, then
# s6-svscan owns /.s6-svscan). keep-id runs it as uid 1000 -> s6 dies with
# "unable to open .s6-svscan/lock: Permission denied". The s6-supervised
# forgejo server itself drops to USER_UID:USER_GID; volumes are pre-chowned
# to 1000:1000 by scripts/pipeline-bootstrap.sh.
Environment=USER_UID=1000
Environment=USER_GID=1000
# FORGEJO__<section>__<KEY> maps to app.ini (verified, admin docker docs);
# DB name/user/passwd + admin bootstrap + server URLs in service.env
Environment=FORGEJO__database__DB_TYPE=postgres
Environment=FORGEJO__service__DISABLE_REGISTRATION=true
# SSH port mapping: container listens on 22, published host port 2223
Environment=FORGEJO__server__SSH_PORT=2223
Environment=FORGEJO__server__SSH_LISTEN_PORT=22
EnvironmentFile=%h/.config/containers/config/forge/service.env
Volume=forge-data:/data
# SSH host keys in their own named volume (stable across recreates; a host
# dir bind is unwritable: ns-root != px without keep-id)
Volume=forge-ssh:/data/ssh
# web loopback; git SSH host port 2223 (also LAN-reachable: host carries no
# nftables/firewalld ruleset — flagged at enable time, plan sec.4)
PublishPort=127.0.0.1:3120:3000/tcp
PublishPort=0.0.0.0:2223:22/tcp

[Service]
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
