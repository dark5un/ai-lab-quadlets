# Generated by install.sh (from config/grafana/service.env.example).
# Grafana on the LAN (plan D2): login required, anonymous off.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-to-a-random-hex-string
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_USERS_ALLOW_SIGN_UP=false
# VictoriaLogs datasource plugin, preinstalled at boot of the container.
GF_PLUGINS_PREINSTALL=victoriametrics-logs-datasource
