[Unit]
Description=DeepSeek Harness (dsh) agent runtime
After=ai-network.service

StartLimitIntervalSec=5min
StartLimitBurst=3

[Container]
ContainerName=systemd-deepseek-harness
# Local build — see containers/deepseek-harness/Containerfile (unpatched npm package).
# Build with: podman build -t localhost/deepseek-harness:0.1.2-rc.1 containers/deepseek-harness/
Image=localhost/deepseek-harness:0.1.2-rc.1
# dsh binds 127.0.0.1 only (upstream safety). Network=host lands that bind on
# the host loopback directly: reachable at http://127.0.0.1:3105, never on the
# LAN. No PublishPort, no bridge, no patches.
Network=host
# Map container node user (uid 1000) to host user so the volume stays writable.
UserNS=keep-id
# Persist dsh config, sessions, and API keys.
Volume=%h/.local/share/deepseek-harness:/home/node/.dsh:Z

# Environment file for provider configuration (API keys).
EnvironmentFile=%h/.config/containers/config/deepseek-harness/service.env

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=120

# No [Install]: boot=false in services.json (the service is parked broken —
# see docs/cleanup-plan.md phase 3). Start manually with
# systemctl --user start deepseek-harness.service