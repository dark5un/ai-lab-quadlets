# Concourse v8.3.3 worker — agentic-pipeline plan. Runs its own
# containerd+overlay for build/task containers, hence privileged: podman
# 6.1.4 quadlets have NO native Privileged= key (man-verified) -> PodmanArgs,
# plus --cgroupns=host per the official compose guidance (nested runtimes need
# a writable cgroup2). StopSignal SIGUSR2 = concourse's graceful drain signal.
# Build volume graph persists in named volume concourse-worker-state
# (CONCOURSE_WORK_DIR=/worker-state, verified from the image config blob).
# Task/resource containers resolve stack siblings via
# CONCOURSE_CONTAINERD_DNS_SERVER=10.89.0.1 (aardvark-dns on the systemd-ai
# gateway, live-probed) + ALLOW_HOST_ACCESS=true (pair per running-worker doc).
# No host port: TSA handshake is in-network to systemd-concourse-web:2222.

[Unit]
Description=Concourse worker (containerd/overlay)
Wants=ai-network.service
Wants=concourse-web.service
After=ai-network.service
After=concourse-web.service

[Container]
ContainerName=systemd-concourse-worker
Image=docker.io/concourse/concourse:8.3.3
Network=ai.network
Exec=worker
PodmanArgs=--privileged --cgroupns=host
StopSignal=SIGUSR2
Volume=%h/.config/containers/config/concourse/keys:/concourse-keys:ro
Volume=concourse-worker-state:/worker-state
EnvironmentFile=%h/.config/containers/config/concourse/worker.env
# worker.env (0600, generated): TSA_HOST=systemd-concourse-web:2222,
# TSA key pair paths under /concourse-keys, BAGGAGECLAIM_DRIVER=overlay,
# CONTAINERD_DNS_SERVER/ALLOW_HOST_ACCESS, NAME=worker-01.

[Service]
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=180
