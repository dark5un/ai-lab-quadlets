[Unit]
Description=Strata Qwen model server (RTX 5090)
After=network-online.target ai-network.service
Wants=network-online.target ai-network.service
StartLimitIntervalSec=20min
StartLimitBurst=2

[Container]
ContainerName=systemd-strata
Image=localhost/strata:rtx5090
Network=ai.network
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
Environment=CUDA_VISIBLE_DEVICES=__STRATA_GPU_UUID__
EnvironmentFile=%h/.config/containers/config/strata/service.env
Volume=%h/.local/share/strata:/data:Z
PublishPort=127.0.0.1:11437:8080/tcp

[Service]
Restart=on-failure
RestartSec=30
TimeoutStartSec=1800
TimeoutStopSec=120

[Install]
WantedBy=default.target
