# Open WebUI configuration
# Fill in your own WEBUI_SECRET_KEY (run: openssl rand -hex 32)
# HOSTNAME.local: install.sh writes "$(hostnamectl --static).local" (mDNS via
# systemd-resolved) into WEBUI_URL and CORS_ALLOW_ORIGIN on every run.

WEBUI_SECRET_KEY=change-me-to-a-random-hex-string
WEBUI_URL=http://HOSTNAME.local:3100
CORS_ALLOW_ORIGIN=http://HOSTNAME.local:3100
WEBUI_SESSION_COOKIE_SECURE=false
WEBUI_AUTH_COOKIE_SECURE=false
WEBUI_SESSION_COOKIE_SAME_SITE=lax
WEBUI_AUTH_COOKIE_SAME_SITE=lax

# Model backends (OpenAI-compatible). MANAGED by install.sh, rewritten on
# every run: strata, llama-cpp-5090, llama-cpp-4070ti, llama-cpp-both, with
# the strata key and the shared llama.cpp key in the same order.
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=
# Env is authoritative: settings stored in webui.db would otherwise
# override the lines above (and survive key rotation). Admin-UI
# changes reset on restart. MANAGED by install.sh.
ENABLE_PERSISTENT_CONFIG=false

# Disable Ollama probing — we only use the OpenAI-compatible backend (llama.cpp).
# Without this, Open WebUI tries host.docker.internal:11434 on every poll.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true