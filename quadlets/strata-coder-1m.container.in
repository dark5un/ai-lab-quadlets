# Strata Coder: Qwen3.8-Flash-Next GSQ-RCO Coder (IQ1_M, half the experts,
# kept for code / tools / vision) on the RTX 4070 Ti 12 GB, port 11439, 1M (1,048,576) context.
# One coder variant at a time (strata-coder 256K, -524k, -1m): same container
# name and port, Conflicts= between them.
# Rendered by scripts/install-strata.sh (GPU UUID and CPU list filled in).
# Not a member of the strata group: it can run BESIDE a 5090 strata variant
# ("duo": `ai-lab strata duo [5090|5090-524k|5090-1m]`), with its own container
# name (clients: http://systemd-strata-coder:8080) and its own setup config.
# It owns the 4070 Ti like strata does: scripts/gpu-arbiter.py stops the other
# 4070 Ti services when it starts, and stops it when strata-4070ti /
# strata-both or another 4070 Ti service starts (it cannot move). Conflicts=
# is the backstop for a bare `systemctl start`.
# No [Install]: nothing starts at boot.

[Unit]
Description=Strata Coder model server (RTX 4070 Ti 12 GB, 1M (1,048,576) context)
Wants=ai-network.service
After=ai-network.service
Conflicts=maya-5090-256.service maya-5090-512.service maya-5090-1024.service maya-both-256.service maya-both-512.service maya-both-1024.service comfyui-4070ti.service llama-cpp-4070ti.service llama-cpp-both.service rizzo.service docling-4070ti.service strata-4070ti-1m.service strata-4070ti-524k.service strata-4070ti.service strata-both.service strata-coder-128k.service strata-coder-524k.service strata-coder.service soulx-duplug.service personaplex.service minicpmo-omni.service
StartLimitIntervalSec=20min
StartLimitBurst=2

[Container]
ContainerName=systemd-strata-coder
Image=localhost/strata-harness:multi
Network=ai.network
AddDevice=nvidia.com/gpu=__GPU_4070TI_UUID__
SecurityLabelDisable=true
# Pinned to the last 8 CPUs (E-cores here), disjoint from the 5090 variants:
# unpinned, two engines side by side drop to a third / half of their speed.
# STRATA_SET=pool-workers=7 keeps the engine's worker pool below the
# pinned core count (pinned cores - 1): workers == cores halves decode.
Entrypoint=/usr/bin/taskset
Exec=-c __CPUS_CODER__ /opt/strata/entrypoint.sh run
# Shared API key etc.; FAMILY/MODEL override service.env (Environment= wins).
EnvironmentFile=%h/.config/containers/config/strata/service.env
Environment=PRESET=strata-coder-1m
Environment=MODEL_PATH=/data/models/coder-IQ1_M
Environment=PARALLEL=1
Environment=STRATA_SET=pool-workers=7
Environment=FAMILY=coder
Environment=MODEL=IQ1_M
Environment=GPU=0
Environment=CONTEXT=1048576
# Past the trained 262,144 setup adds YaRN rope scaling (factor 4),
# fixed for the whole run: a separate variant, not a per-request option.
Environment=KV=int8
Volume=%h/.local/share/strata/models:/data/models:z
Volume=%h/.local/share/strata/mtp:/data/mtp:z
Volume=%h/.local/share/strata/packs:/data/packs:z
Volume=%h/.local/share/strata/Strata-data:/data/Strata-data:Z
Volume=%h/.local/share/strata/config-coder-1m:/data/config:Z
Volume=%h/.local/share/strata/state:/data/state:Z
Volume=%h/.local/share/strata/install:/data/install:Z
Volume=%h/.local/share/strata/home:/data/home:Z
PublishPort=0.0.0.0:11439:8080/tcp

[Service]
# Upstream #3238: this session inherits RLIMIT_RTTIME=0 (PipeWire without
# rtkit) and the engine can get SIGKILL'ed with no OOM line. Never inherit it.
LimitRTTIME=infinity
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=30
TimeoutStartSec=3600
TimeoutStopSec=120
