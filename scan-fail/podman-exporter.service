# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# podman-exporter (monitoring tier, boot). Container state/stats through
# px's USER podman socket: podman.socket (user unit) must be enabled —
# install.sh enables it. No --userns=keep-id here (the stack's usual
# convention): the exporter runs as container root, which maps to px in
# the user namespace and can talk to the socket; keep-id:uid=65534 was
# verified working in the 2026-10-08 probe but is unnecessary.
# Default collectors only: --collector.enable-all made scrapes hang
# (>90 s) on the image-size cache in that probe; container_state/info/
# stats, which the dashboards need, are on by default.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Prometheus podman exporter (container metrics)
Wants=ai-network.service
After=ai-network.service
After=podman.socket
SourcePath=/home/px/.config/containers/systemd/podman-exporter.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-podman-exporter
Image=quay.io/navidys/prometheus-podman-exporter@sha256:360ee8dc2acb3d64e6339138febc210d25fb4a355dcecdae0cf2a1128011ab17
Network=ai.network
PublishPort=127.0.0.1:9882:9882/tcp
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Volume=%t/podman/podman.sock:/run/podman/podman.sock
# The image runs as USER 65534: keep-id:uid=65534 maps that to a subuid
# that owns the socket inside the container (verified in the 2026-10-08
# probe; without it the exporter cannot talk to the API and hangs).
UserNS=keep-id:uid=65534

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-podman-exporter
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-podman-exporter
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-podman-exporter --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id:uid=65534 -v %t/podman/podman.sock:/run/podman/podman.sock --publish 127.0.0.1:9882:9882/tcp --env CONTAINER_HOST=unix:///run/podman/podman.sock quay.io/navidys/prometheus-podman-exporter@sha256:360ee8dc2acb3d64e6339138febc210d25fb4a355dcecdae0cf2a1128011ab17

[Install]
WantedBy=default.target
