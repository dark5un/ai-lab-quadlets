# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# Fluent Bit (monitoring tier, boot). Ships px's USER journal to
# VictoriaLogs. Two verified pitfalls (2026-10-08 bake-off):
#   - image must be 4.2+: fluent-bit 4.0's systemd input silently reads
#     0 records from this ZSTD-compressed journal (systemd 262);
#   - do NOT use --userns=keep-id: the journal ACL grants read to px,
#     and the container's root already maps to px; keep-id makes the
#     process nobody and the input again reads 0 records without error.
# The read cursor lives on a volume (db) so restarts do not re-ingest.
# Config rendered by scripts/render-prometheus.py into
# config/fluent-bit/fluent-bit.conf.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Fluent Bit (user journal -> VictoriaLogs)
Wants=ai-network.service
After=ai-network.service
After=victorialogs.service
SourcePath=/home/px/.config/containers/systemd/fluent-bit.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service
RequiresMountsFor=/var/log/journal

[X-Container]
ContainerName=systemd-fluent-bit
Image=docker.io/fluent/fluent-bit@sha256:6806769c10acf11b41d14083b3101a24433b4ca113a1ab7a6b1a1b7cad86a7e8
Network=ai.network
# loopback only: the built-in HttpServer (/api/v1/health) for debugging.
PublishPort=127.0.0.1:2020:2020/tcp
Volume=%h/.config/containers/config/fluent-bit:/cfg:ro,Z
Volume=fluent-bit-db:/db:z
Volume=/var/log/journal:/var/log/journal:ro
# Exec appends to the image entrypoint (/fluent-bit/bin/fluent-bit).
Exec=-c /cfg/fluent-bit.conf

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-fluent-bit
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-fluent-bit
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-fluent-bit --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d -v %h/.config/containers/config/fluent-bit:/cfg:ro,Z -v fluent-bit-db:/db:z -v /var/log/journal:/var/log/journal:ro --publish 127.0.0.1:2020:2020/tcp docker.io/fluent/fluent-bit@sha256:6806769c10acf11b41d14083b3101a24433b4ca113a1ab7a6b1a1b7cad86a7e8 -c /cfg/fluent-bit.conf

[Install]
WantedBy=default.target
