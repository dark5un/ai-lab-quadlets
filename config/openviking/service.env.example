# OpenViking - secret-bearing env (generate-secrets.sh creates the deployed
# copy, mode 600; do not commit the real file).
# OPENVIKING_ROOT_API_KEY is the credential the server enforces; install.sh
# renders the SAME value into config/openviking/ov.conf (server.root_api_key)
# and keeps the strata/llama.cpp keys current there. Host-side clients
# (curl /health, ov CLI) read the key from this file - never echo it.
OPENVIKING_ROOT_API_KEY=change-me-to-a-random-hex-string
