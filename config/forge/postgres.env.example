# Forgejo PostgreSQL server env — generated on-target (config/forge/postgres.env,
# 0600; agentic-pipeline plan). Consumed by the postgres image entrypoint only:
# keep foreign variables OUT (image-entrypoint audit, mysql precedent).
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=change-me-to-a-random-hex-string
