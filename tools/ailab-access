#!/usr/bin/env python3
"""ailab-access — one-shot access card for every quadlet service in the
ai-lab stack: service name, access URL, Tailscale URL + port, host port,
and EVERY credential the stack stores for that service (login user +
password, bearer/API tokens, keypairs), one row per credential.

Sources of truth (all live, read-only):
  * ~/workspace/github.com/dark5un/ai-lab-quadlets/services.json  (registry)
  * `tailscale serve status`                                      (doors)
  * ~/.config/containers/config/<svc>/                            (creds)
  * ~/.workspaces/vscode-pr/*/state.json                          (live PR envs)

Secrets are printed because this is the owner's own machine; the output
contains real credentials — do not paste it into anything shared.
"""
from __future__ import annotations

import json
import pathlib
import re
import subprocess
import sys

HOME = pathlib.Path.home()
REGISTRY = HOME / "workspace/github.com/dark5un/ai-lab-quadlets/services.json"
CONF = HOME / ".config/containers/config"
PR_ENVS = HOME / ".workspaces/vscode-pr"

# Credential model: service -> list of rows.
# row = (kind, label, user_spec, secret_spec)
#   user_spec   ("lit", "text") | ("env", relpath, KEY) | ("-",)
#   secret_spec ("env", relpath, KEY) | ("file", relpath) | ("firstline", relpath)
#   pairs_spec  ("pairs", relpath, KEY, sep)  -> expands to one row per user:pass
CRED: dict[str, list] = {
    "dufs":          [("basic", "WebDAV login", ("env", "dufs/service.env", "DAV_USER"),
                       ("env", "dufs/service.env", "DAV_PASSWORD"))],
    "s3-webdav":     [("basic", "WebDAV (Garage) login", ("env", "s3-webdav/service.env", "S3_WEBDAV_USER"),
                       ("env", "s3-webdav/service.env", "S3_WEBDAV_PASSWORD"))],
    "vscode":        [("token", "connection token", ("-",), ("env", "vscode/service.env", "VSCODE_CONNECTION_TOKEN"))],
    "ragflow": [
        ("login", "console login (kb-bot)", ("lit", "kb-bot@local.ai"),
         ("file", "ragflow/.kbuser_pw_once")),
        ("apikey", "API PAT (kb-bot; canonical copy)", ("lit", "kb-bot@local.ai"),
         ("env", "kb-watcher/service.env", "RAGFLOW_API_KEY")),
        ("svc", "internal super-admin — service-only, CANNOT console-login", ("lit", "admin@ragflow.io"),
         ("file", "ragflow/.admin_pw_once")),
    ],
    "lightrag":      [("apikey", "X-API-Key", ("-",), ("env", "lightrag/service.env", "LIGHTRAG_API_KEY"))],
    "concourse-web": [
        ("pairs", "local users (main team = the ones marked main)", ("pairs", "concourse/web.env", "CONCOURSE_ADD_LOCAL_USER", ","),
         None),
    ],
    "concourse-mcp": [
        ("bearer", "MCP token (hermes, main-team rights)", ("-",), ("env", "concourse/mcp.env", "MCP_TOKEN_HERMES")),
        ("bearer", "MCP token (pipeline, read/trigger)", ("-",), ("env", "concourse/mcp.env", "MCP_TOKEN_PIPELINE")),
        ("basic", "low-priv Concourse user (agent team)", ("env", "concourse/mcp.env", "CONCOURSE_LOWPRIV_USER"),
         ("env", "concourse/mcp.env", "CONCOURSE_LOWPRIV_PASSWORD")),
    ],
    "forge": [
        ("basic", "instance admin login", ("env", "forge/service.env", "FORGEJO_ADMIN_USER"),
         ("env", "forge/service.env", "FORGEJO_ADMIN_PASSWORD")),
        ("token", "API token (pipeline scopes)", ("-",), ("file", "forge/token")),
    ],
    "s3":            [("s3key", "Garage key pair", ("env", "s3/service.env", "GARAGE_KEY_ID"),
                       ("env", "s3/service.env", "GARAGE_SECRET"))],
    "notebook":      [("token", "Jupyter server token", ("lit", "(any/blank)"), ("file", "notebook/jupyter-token"))],
    "ailab-api":     [("bearer", "control API token", ("-",), ("env", "ailab-api/service.env", "AILAB_API_TOKEN"))],
    "strata-5090":   [("apikey", "API key (all strata variants)", ("-",), ("env", "strata/service.env", "API_KEY"))],
    "embeddings":    [("apikey", "API key", ("-",), ("env", "lightrag/service.env", "EMBEDDING_BINDING_API_KEY"))],
