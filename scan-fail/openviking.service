# No install section by design: on-demand only (ai-lab convention).
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-openviking
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-openviking
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-openviking --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v %h/.local/share/ai-lab/openviking:/app/.openviking:Z --publish 0.0.0.0:3110:1933/tcp --env OPENVIKING_WITH_BOT=0 --env-file %h/.config/containers/config/openviking/service.env ghcr.io/volcengine/openviking@sha256:551b1ae00f59fd7b1a2434ecc10a4860be34aae8b7627f5f57240be355b23217
