# GPU llama.cpp quadlet — GENERATED by scripts/detect-gpus.sh
# This file is re-generated on each install. Do not edit directly.

[Unit]
Description=llama.cpp {GPU_NAME} research router
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=llama-cpp-research
Image=ghcr.io/ggml-org/llama.cpp:server-cuda

# GPU assignment: {GPU_NAME} ({GPU_VRAM} GB)
AddDevice=nvidia.com/gpu={GPU_UUID}
SecurityLabelDisable=true

# Keep container user mapped to host user for volume access.
UserNS=keep-id

Network=ai.network

# Native host clients:
# http://127.0.0.1:11436/v1
PublishPort=0.0.0.0:11436:8080

# The same physical model directory as the primary service.
Volume=%h/.local/share/llama.cpp/models:/models:ro,Z

# Per-model preset config.
Volume=%h/.config/containers/config/llama.cpp-research/presets.ini:/etc/llama-cpp/presets.ini:ro

EnvironmentFile=%h/.config/containers/config/llama.cpp-research/service.env

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
MemoryMax={MEMORY_MAX}G

[Install]
WantedBy=default.target