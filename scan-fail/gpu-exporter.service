# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# nvidia_gpu_exporter (monitoring tier, boot). Both cards via NVML,
# metrics keyed by GPU UUID. It needs the CDI devices to talk to NVML,
# but holds no VRAM and must not count as a GPU service for
# scripts/gpu-arbiter.py: the registry entry carries NO gpu field, and
# tests/test-quadlet-policy.sh whitelists this one unit for AddDevice.
# The -nvml image tag talks to NVML directly (no nvidia-smi fork per
# scrape). Idle RSS ~35 MB.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=NVIDIA GPU exporter (both cards, NVML)
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/gpu-exporter.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-gpu-exporter
Image=docker.io/utkuozdemir/nvidia_gpu_exporter@sha256:92a73ec03e2f5cae4a7cfcc99c242b46797741c24de8f3768d394925f8e0a323
Network=ai.network
PublishPort=127.0.0.1:9835:9835/tcp
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true

[Service]
