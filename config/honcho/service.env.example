# Honcho self-host config - ONE file shared by honcho-database, honcho-api
# and honcho-deriver (quadlet EnvironmentFile). generate-secrets.sh creates
# the deployed copy (mode 600) filling the two secret placeholders with the
# SAME password in POSTGRES_PASSWORD and in the DB_CONNECTION_URI; install.sh
# rewrites the managed key lines (strata + llama.cpp keys) on every run.
# Never commit the deployed file, never echo values.

# ── honcho-database (postgres entrypoint) ──────────────────────────────────
POSTGRES_PASSWORD=change-me-to-a-random-hex-string

# ── honcho-api / honcho-deriver: database ──────────────────────────────────
DB_CONNECTION_URI=postgresql+psycopg://honcho:change-me-to-a-random-hex-string@systemd-honcho-database:5432/honcho

# ── auth (required for the 0.0.0.0 bind) ───────────────────────────────────
AUTH_USE_AUTH=true
AUTH_JWT_SECRET=change-me-to-another-random-hex-string

# ── cache: no redis in this deployment (honcho default is off) ─────────────
CACHE_ENABLED=false

# ── LLM: strata (OpenAI-compatible); the proven tool-caller this fleet runs
#    on. MANAGED by install.sh: LLM_OPENAI_API_KEY = strata API_KEY. ────────
LLM_OPENAI_API_KEY=
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=qwen3.8-flash-next-iq3_s
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-strata:8080/v1

# ── embeddings: the CPU llama.cpp server (bge-m3, dense 1024).
#    MANAGED by install.sh: EMBEDDING_API_KEY = shared llama.cpp key. ──────
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=bge-m3
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://systemd-embeddings:8080/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=EMBEDDING_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_VECTOR_DIMENSIONS=1024

# ── housekeeping ────────────────────────────────────────────────────────────
TELEMETRY_ENABLED=false
SENTRY_ENABLED=false
LOG_LEVEL=INFO
