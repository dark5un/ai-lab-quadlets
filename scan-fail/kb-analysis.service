[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Knowledge-base analysis helper (W1-W4 state + reports)
Wants=ai-network.service
Wants=ragflow.service
After=ai-network.service
After=ragflow.service
SourcePath=/home/px/.config/containers/systemd/kb-analysis.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-kb-analysis
Image=localhost/kb-watcher:latest
Network=ai.network
UserNS=keep-id
EnvironmentFile=%h/.config/containers/config/kb-watcher/service.env
PodmanArgs=--entrypoint=/app/analysis.py
Exec=serve
Volume=%h/workspace/github.com/dark5un/ai-lab-quadlets/kb:/home/px/workspace/github.com/dark5un/ai-lab-quadlets/kb

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-kb-analysis
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-kb-analysis
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-kb-analysis --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v %h/workspace/github.com/dark5un/ai-lab-quadlets/kb:/home/px/workspace/github.com/dark5un/ai-lab-quadlets/kb --env-file %h/.config/containers/config/kb-watcher/service.env --entrypoint=/app/analysis.py localhost/kb-watcher:latest serve
