[Unit]
Description=Sketchlab - diagramming SPA with save/load backend
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-sketchlab
Image=localhost/sketchlab:v0.6.2
Network=ai.network
EnvironmentFile=%h/.config/containers/config/sketchlab/service.env
PublishPort=0.0.0.0:3102:8080/tcp
UserNS=keep-id
Volume=%h/.local/share/sketchlab:/data:Z

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=120
