# Strata variant: RTX 4070 Ti 12 GB, 1M (1,048,576) context.
# Rendered by scripts/install-strata.sh (GPU UUIDs filled in from nvidia-smi).
# One strata variant (strata-5090, -5090-524k, -5090-1m, -4070ti, -4070ti-524k,
# -4070ti-1m, -both) runs at
# a time: they share the container name (clients use http://systemd-strata:8080)
# and host port 11434, and Conflicts= makes systemd stop the running one first.
# This variant also stops strata-coder (it needs the 4070 Ti).
# Strata owns its card(s). Use `ai-lab` / the bar widget to start GPU services:
# scripts/gpu-arbiter.py moves strata or ComfyUI to the other card. Conflicts=
# below is only the backstop for a bare `systemctl start`, which STOPS the
# other side instead of moving it (Conflicts= works in both directions).
# No [Install]: nothing starts at boot; switch with `ai-lab strata 4070ti-1m` or the
# AI Lab bar widget.

[Unit]
Description=Strata Qwen model server (RTX 4070 Ti 12 GB, 1M (1,048,576) context)
Wants=ai-network.service
After=ai-network.service
Conflicts=strata-5090.service strata-5090-524k.service strata-5090-1m.service strata-both.service llama-cpp-4070ti.service rizzo.service comfyui-4070ti.service llama-cpp-both.service strata-coder.service strata-4070ti.service strata-4070ti-524k.service strata-coder-524k.service strata-coder-1m.service
StartLimitIntervalSec=20min
StartLimitBurst=2

[Container]
ContainerName=systemd-strata
Image=localhost/strata:multi
Network=ai.network
# The container sees only the card(s) below, so nvidia-smi and CUDA agree on
# the numbering inside it; GPU=0 is that card.
AddDevice=nvidia.com/gpu=__GPU_4070TI_UUID__
SecurityLabelDisable=true
# Shared settings + API key (FAMILY, MODEL, VISION, LOW_RAM, API_KEY).
EnvironmentFile=%h/.config/containers/config/strata/service.env
# Per-variant settings. CONTEXT/KV only matter at the first setup, which
# writes config-4070ti-1m/strata-<quant>.json; install-strata.sh derives it
# from config-4070ti's 256K json (same model; context + YaRN args only).
# MODEL overrides service.env (--env wins over --env-file): IQ3_XXS here,
# picked from the 2026-10-08 quant bench (vs IQ3_S: +28% decode, +16% prefill,
# task avg 92.57 vs 93.26). The 5090 variants stay on IQ3_S.
Environment=MODEL=IQ3_XXS
Environment=GPU=0
Environment=CONTEXT=1048576
# Past the trained 262,144 setup adds YaRN rope scaling (factor 4),
# fixed for the whole run: a separate variant, not a per-request option.
Environment=KV=int8
# Model data is shared by all variants; the setup config is per variant.
Volume=%h/.local/share/strata/models:/data/models:z
Volume=%h/.local/share/strata/mtp:/data/mtp:z
Volume=%h/.local/share/strata/packs:/data/packs:z
Volume=%h/.local/share/strata/config-4070ti-1m:/data/config:Z
PublishPort=0.0.0.0:11434:8080/tcp

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=30
TimeoutStartSec=1800
TimeoutStopSec=120
