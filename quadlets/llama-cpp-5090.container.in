# llama.cpp router on the RTX 5090 32 GB.
# Rendered by scripts/render-units.sh (GPU UUID filled in from nvidia-smi).
# The card is fixed. Start it through `ai-lab start llama-cpp-5090` or the AI Lab
# bar widget: scripts/gpu-arbiter.py moves strata off this card first when
# strata-5090 or strata-both is running (a bare `systemctl start` would stop strata instead,
# via the strata units' Conflicts=).
# No [Install]: nothing starts at boot.

[Unit]
Description=llama.cpp router (RTX 5090 32 GB)
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-llama-cpp-5090
Image=ghcr.io/ggml-org/llama.cpp:server-cuda
Network=ai.network
# Pin the card at the CUDA layer (the stack's convention for non-strata
# services; see README "GPU pinning").
AddDevice=nvidia.com/gpu=all
Environment=CUDA_VISIBLE_DEVICES=__GPU_5090_UUID__
SecurityLabelDisable=true
UserNS=keep-id

# http://<host>:11435/v1 - every request needs a key from keys.txt.
# Containers on systemd-ai: http://systemd-llama-cpp-5090:8080/v1
PublishPort=0.0.0.0:11435:8080

# Models linked for this card only (hardlinks into the HF cache; see
# scripts/hf-download.sh --card). One subdir per model; id = dir name.
Volume=%h/.local/share/llama.cpp/cards/5090:/models:ro,Z
# Per-card router settings and presets.
EnvironmentFile=%h/.config/containers/config/llama-cpp-5090/service.env
Volume=%h/.config/containers/config/llama-cpp-5090/presets.ini:/etc/llama-cpp/presets.ini:ro,Z
# API keys shared by both cards (LLAMA_ARG_API_KEY_FILE).
Volume=%h/.config/containers/config/llama-cpp/keys.txt:/etc/llama-cpp/keys.txt:ro

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
MemoryMax=64G
