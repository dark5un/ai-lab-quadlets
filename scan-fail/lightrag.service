# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# Knowledge-graph server - HKUDS LightRAG v1.5.7 (MIT), standalone per plan
# R5: the graph lives in plain PostgreSQL tables + JSONB (PGTableGraphStorage,
# no AGE extension -> Cloud SQL portable) with pgvector for embeddings and
# PGKV/PGDocStatus for the rest. LLM = strata, embeddings = bge-m3 (dim 1024
# FROZEN at table creation - changing the embedding model means recreating
# kb-lightrag-pg-data). All wiring in config/lightrag/service.env (600).
# UI + query API on 9621; loopback publish only (3116). Storage for inputs
# (pushed by kb-watcher) and pipeline scratch lives in a named volume.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=LightRAG knowledge-graph server
Wants=ai-network.service
Wants=kb-postgres.service
After=ai-network.service
After=kb-postgres.service
SourcePath=/home/px/.config/containers/systemd/lightrag.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-lightrag
Image=ghcr.io/hkuds/lightrag:v1.5.7
Network=ai.network
UserNS=keep-id
PublishPort=127.0.0.1:3116:9621/tcp
EnvironmentFile=%h/.config/containers/config/lightrag/service.env
Volume=kb-lightrag-data:/app/data

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
# First start creates the PG schema (tables + pgvector indexes at dim 1024).
TimeoutStartSec=600
TimeoutStopSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-lightrag
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-lightrag
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-lightrag --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v kb-lightrag-data:/app/data --publish 127.0.0.1:3116:9621/tcp --env-file %h/.config/containers/config/lightrag/service.env ghcr.io/hkuds/lightrag:v1.5.7
