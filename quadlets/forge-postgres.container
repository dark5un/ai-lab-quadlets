# Forgejo PostgreSQL - stock docker.io/library/postgres:18 (agentic-pipeline
# plan). Same sidecar shape as windmill-postgres: separate instance for
# blast-radius isolation, NO host port (reachable only as
# systemd-forge-pg:5432). POSTGRES_* live in config/forge/postgres.env (600);
# the copy inside forge/service.env (FORGEJO__database__*) is mirrored by
# generate-secrets.sh.

[Unit]
Description=Forgejo PostgreSQL
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-forge-pg
Image=docker.io/library/postgres:18
Network=ai.network
UserNS=keep-id
EnvironmentFile=%h/.config/containers/config/forge/postgres.env
# PG 18 official images store data in major-version-specific dirs
# (/var/lib/postgresql/18/docker) - mount the PARENT (docker-library/postgres#1259).
Volume=forge-db-data:/var/lib/postgresql

[Service]
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
