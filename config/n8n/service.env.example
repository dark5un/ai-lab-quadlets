# Generated on-target by scripts/generate-secrets.sh. Consumed by n8n.container.
# N8N_ENCRYPTION_KEY protects stored workflow credentials; losing it makes
# n8n's credential store unreadable (rotate-secrets.sh covers it).
N8N_ENCRYPTION_KEY=change-me-to-a-random-hex-string
GENERIC_TIMEZONE=Europe/London
N8N_DIAGNOSTICS_ENABLED=false
# loopback-only exposure (127.0.0.1:3115); no tailnet door until needed
N8N_SECURE_COOKIE=true
