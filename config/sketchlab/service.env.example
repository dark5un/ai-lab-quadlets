# Sketchlab same-origin AI proxy (/v1/ -> local model server).
# The nginx entrypoint renders nginx/ai-proxy.conf.template with these values.
# STRATA_API_KEY is copied from config/strata/service.env by install.sh;
# do not commit the real key.
STRATA_UPSTREAM=http://systemd-strata:8080
STRATA_API_KEY=
