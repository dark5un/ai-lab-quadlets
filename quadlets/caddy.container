[Unit]
Description=Caddy HTTPS reverse proxy
After=network-online.target open-webui.service
Wants=network-online.target open-webui.service

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2-alpine
Network=ai.network
PublishPort=3001:3001/tcp
PublishPort=3002:3002/tcp
PublishPort=3003:3003/tcp
PublishPort=3004:3004/tcp
Volume=%h/.config/containers/config/caddy:/etc/caddy:ro,Z
Volume=caddy-data:/data
Volume=caddy-config:/config

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=default.target