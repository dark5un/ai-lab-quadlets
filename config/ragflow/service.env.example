# Generated on-target by scripts/generate-secrets.sh (every placeholder slot
# gets fresh random hex). Consumed by ragflow.container (EnvironmentFile) AND
# by the ragflow-* dependency units that need the same credentials.
# Endpoints follow the ai.network alias rule (systemd-<unit>:<container_port>),
# never host loopback.
DOC_ENGINE=elasticsearch
DB_TYPE=mysql
DEVICE=cpu

# --- doc engine (ragflow-elasticsearch) ---
ES_HOST=systemd-ragflow-elasticsearch
ELASTIC_PASSWORD=change-me-to-a-random-hex-string

# --- metadata db (ragflow-mysql) ---
# Client-side only: the mysql SERVER gets its own mysql.env (the image's
# entrypoint rejects MYSQL_USER=root, so the shared file must not reach it);
# generate-secrets.sh keeps MYSQL_ROOT_PASSWORD there equal to this value.
MYSQL_HOST=systemd-ragflow-mysql
MYSQL_DBNAME=rag_flow
MYSQL_USER=root
MYSQL_PASSWORD=change-me-to-another-random-hex-string

# --- object storage (ragflow-minio, pgsty/silo MinIO-compatible fork) ---
MINIO_HOST=systemd-ragflow-minio
MINIO_USER=ragflow
MINIO_ROOT_PASSWORD=change-me-to-a-third-random-hex-string
MINIO_PASSWORD=change-me-to-a-third-random-hex-string

# --- cache/queue (ragflow-kvrocks; REDIS_PASSWORD is the kvrocks requirepass,
# the name is upstream's: the Go services call the kvrocks backend "redis") ---
KVROCKS_HOST=systemd-ragflow-kvrocks
KVROCKS_PORT=6379
REDIS_PASSWORD=change-me-to-a-fourth-random-hex-string

# --- ingestion queue (ragflow-nats) ---
NATS_HOST=systemd-ragflow-nats
NATS_PORT=4222

# --- default superuser (admin@ragflow.io) created by --init-superuser ---
ADMIN_DEFAULT_PASSWORD=change-me-to-a-fifth-random-hex-string
