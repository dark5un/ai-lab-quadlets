# GPU llama.cpp quadlet — GENERATED by scripts/detect-gpus.sh
# This file is re-generated on each install. Do not edit directly.
# Edit the template in scripts/templates/llama-cpp-main.container.in instead.

[Unit]
Description=llama.cpp {GPU_NAME} long-context router
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=systemd-llama-cpp-main
Image=ghcr.io/ggml-org/llama.cpp:server-cuda

# GPU assignment: {GPU_NAME} ({GPU_VRAM} GB)
#
# Pass every GPU node and pin this service's card by UUID at the CUDA layer.
# Do NOT pin with `AddDevice=nvidia.com/gpu={GPU_UUID}`: the /dev/nvidiaN *minor
# number* is (re)assigned when the driver loads and can flip across a reboot, while
# CDI is read at container start. A stale /etc/cdi/nvidia.yaml then hands the
# container the wrong physical GPU (llama.cpp dies with a cudaMalloc failure for a
# size that fits the card it thinks it has). CUDA_VISIBLE_DEVICES accepts a GPU UUID
# and is resolved by the CUDA runtime, so it survives any minor reshuffle.
AddDevice=nvidia.com/gpu=all
Environment=CUDA_VISIBLE_DEVICES={GPU_UUID}
SecurityLabelDisable=true

# Keep container user mapped to host user for volume access.
UserNS=keep-id

Network=ai.network

# Native host clients:
# http://127.0.0.1:11435/v1
PublishPort=0.0.0.0:11435:8080

# Shared read-only model library.
Volume=%h/.local/share/llama.cpp/models:/models:ro,Z

# Per-model preset config.
Volume=%h/.config/containers/config/llama.cpp/presets.ini:/etc/llama-cpp/presets.ini:ro,Z

# Api keys.
Volume=%h/.config/containers/config/llama.cpp/keys.txt:/etc/llama-cpp/keys.txt:ro

EnvironmentFile=%h/.config/containers/config/llama.cpp/service.env

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
MemoryMax={MEMORY_MAX}G

[Install]
WantedBy=default.target