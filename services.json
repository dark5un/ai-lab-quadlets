{
  "network": "systemd-ai",
  "services": [
    {
      "name": "llama-cpp-main",
      "unit": "llama-cpp-main.service",
      "container": "systemd-llama-cpp-main",
      "host_port": 11435,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/health",
      "tier": "core",
      "image": "ghcr.io/ggml-org/llama.cpp:server-cuda",
      "boot": true
    },
    {
      "name": "llama-cpp-research",
      "unit": "llama-cpp-research.service",
      "container": "systemd-llama-cpp-research",
      "host_port": 11436,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/health",
      "tier": "optional",
      "image": "ghcr.io/ggml-org/llama.cpp:server-cuda",
      "boot": false
    },
    {
      "name": "strata",
      "unit": "strata.service",
      "container": "systemd-strata",
      "host_port": 11437,
      "container_port": 8080,
      "bind": "127.0.0.1",
      "health": "/health",
      "tier": "optional",
      "image": "localhost/strata:rtx5090",
      "boot": true
    },
    {
      "name": "open-webui",
      "unit": "open-webui.service",
      "container": "systemd-open-webui",
      "host_port": 3100,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/health",
      "tier": "web",
      "image": "ghcr.io/open-webui/open-webui:v0.11.3",
      "boot": true
    },
    {
      "name": "comfyui",
      "unit": "comfyui.service",
      "container": "systemd-comfyui",
      "host_port": 3101,
      "container_port": 8188,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "image",
      "image": "localhost/comfyui:v0.34.0-cu130",
      "boot": true
    },
    {
      "name": "sketchlab",
      "unit": "sketchlab.service",
      "container": "systemd-sketchlab",
      "host_port": 3102,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "web",
      "image": "localhost/sketchlab:v0.5.0",
      "boot": true
    },
    {
      "name": "hyperframes",
      "unit": "hyperframes.service",
      "container": "systemd-hyperframes",
      "host_port": 3103,
      "container_port": 8080,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "video",
      "image": "localhost/hyperframes:latest",
      "boot": true
    },
    {
      "name": "hermes",
      "unit": "hermes.service",
      "container": "systemd-hermes",
      "host_port": 3104,
      "container_port": 9119,
      "bind": "0.0.0.0",
      "health": "/",
      "tier": "opt-in",
      "image": "docker.io/nousresearch/hermes-agent:latest",
      "boot": false
    },
    {
      "name": "deepseek-harness",
      "unit": "deepseek-harness.service",
      "container": "systemd-deepseek-harness",
      "host_port": 3105,
      "container_port": 3105,
      "bind": "127.0.0.1",
      "health": "/",
      "tier": "opt-in",
      "image": "localhost/deepseek-harness:0.1.2-rc.1",
      "boot": false
    }
  ]
}
