# Open WebUI configuration
# Fill in your own WEBUI_SECRET_KEY (run: openssl rand -hex 32)
# HOSTNAME.local is replaced with $(hostname -s).local during install.

WEBUI_SECRET_KEY=change-me-to-a-random-hex-string
WEBUI_URL=https://HOSTNAME.local:3001
CORS_ALLOW_ORIGIN=https://HOSTNAME.local:3001
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SAME_SITE=lax
WEBUI_AUTH_COOKIE_SAME_SITE=lax

# llama.cpp backend (replaces Ollama).
# llama.cpp serves an OpenAI-compatible API.
OPENAI_API_BASE_URLS=http://llama-cpp:8080/v1
# llama.cpp runs open-mode (no --api-key) in the container; a non-empty
# placeholder satisfies Open WebUI's key-required field but is ignored.
OPENAI_API_KEYS=no-key-required