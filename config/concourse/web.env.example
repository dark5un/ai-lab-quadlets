# Concourse web env — generated on-target (config/concourse/web.env, 0600;
# agentic-pipeline plan). CONCOURSE_ADD_LOCAL_USER carries pipeline (main
# team) + agent (restricted team, used by the low-privilege MCP token) —
# passwords filled by generate-secrets.sh. The <tailnet> FQDN placeholder is
# replaced from `tailscale status --json`. Postgres creds mirror
# config/concourse-postgres/service.env (stack mirror rule). Key file paths
# point at the ro bind of config/concourse/keys/ (also generated).
CONCOURSE_EXTERNAL_URL=https://concourse.<tailnet>
CONCOURSE_CLUSTER_NAME=agentic-pipeline
CONCOURSE_SESSION_SIGNING_KEY=/concourse-keys/session_signing_key
CONCOURSE_TSA_HOST_KEY=/concourse-keys/tsa_host_key
CONCOURSE_TSA_AUTHORIZED_KEYS=/concourse-keys/authorized_worker_keys
CONCOURSE_POSTGRES_HOST=systemd-concourse-pg
CONCOURSE_POSTGRES_USER=atc
CONCOURSE_POSTGRES_PASSWORD=change-me-to-a-random-hex-string
CONCOURSE_POSTGRES_DATABASE=atc
CONCOURSE_ADD_LOCAL_USER=pipeline:change-me-to-another-random-hex-string,agent:change-me-to-a-third-random-hex-string
CONCOURSE_MAIN_TEAM_LOCAL_USER=pipeline
