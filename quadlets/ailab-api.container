# ailab-api — tailnet-only control API for the AI Lab stack: the backend of
# the macOS menu-bar widget (mac-quadlet-widget plan; the on-machine Plasma
# widget keeps exec'ing the CLI directly).
# Exposure: the app binds 127.0.0.1:3119 itself (Network=host, no PublishPort,
# same shape as deepseek-harness); `tailscale serve --https=8448` gives the
# tailnet door https://ai.<tailnet>.ts.net:8448 (LE cert, tailnet-only, never
# LAN). Auth: bearer token from ~/.config/containers/config/ailab-api/service.env
# (scripts/generate-secrets.sh), never in argv or unit files.
# Every mutation runs through scripts/ai-lab -> scripts/gpu-arbiter.py, so the
# GPU card rules hold; the API allowlists names from services.json.
# Why Network=host: ai-lab status health-probes host loopback ports. Why the
# session bus mount (%t/bus + DBUS_SESSION_BUS_ADDRESS): the API shells out to
# systemctl --user to drive the host's user manager. The private socket
# (%t/systemd/private) does NOT work here: across the container PID namespace
# the kernel reports SO_PEERCRED {pid=0} to the client, sd-bus's server
# credential check fails, and the connection is refused before SASL. The
# session bus (dbus-broker, running for this lingered user) authenticates the
# other direction only (container root appears as host uid 1000 = px) and
# works without --pid=host. Verified live 2026-11-10 (start/stop cycle of a
# unit from a plain rootless container).
# The bus socket grants control of ALL user units — deliberate trust, narrowed
# by the API to registry-allowlisted start/stop/toggle/restart + switch
# commands. The repo is mounted ro at the identical host path (single source
# of truth: scripts + services.json).
# Boots at boot: the Mac widget must never gap while the owner is away (owner
# directive 2026-11-10: all functionality accessible from the tailnet).

[Unit]
Description=AI Lab control API (tailnet-only)

[Container]
ContainerName=systemd-ailab-api
Image=localhost/ailab-api:latest
Network=host
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=AI_LAB_REPO=/home/px/workspace/github.com/dark5un/ai-lab-quadlets
EnvironmentFile=%h/.config/containers/config/ailab-api/service.env
Volume=%h/workspace/github.com/dark5un/ai-lab-quadlets:/home/px/workspace/github.com/dark5un/ai-lab-quadlets:ro,Z
Volume=%t/bus:/run/user/1000/bus
# px's uid is 1000 on this host; the bus socket path is uid-specific.

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
