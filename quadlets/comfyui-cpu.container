[Unit]
Description=ComfyUI (CPU)
After=network-online.target ai-network.service
Wants=network-online.target

[Container]
ContainerName=comfyui
# CPU build — see containers/comfyui/Containerfile.cpu.
# Build with: podman build -t localhost/comfyui-cpu:v0.30.2 containers/comfyui/ -f Containerfile.cpu
Image=localhost/comfyui-cpu:v0.30.2
Network=ai.network
PublishPort=127.0.0.1:8188:8188/tcp
Volume=%h/.local/share/comfyui:/data:Z
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/data/user/.cache
Environment=HF_HOME=/data/user/.cache/huggingface
# Force CPU mode: makes torch.cuda.is_available() return False.
Environment=CUDA_VISIBLE_DEVICES=""

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=default.target