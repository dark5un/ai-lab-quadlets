# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# Embeddings - llama.cpp server (CPU) with bge-m3 Q8_0 (dense 1024).
# Dedicated model dir: never link embedding models into the GPU card dirs
# (~/.local/share/llama.cpp/cards) - the routers advertise everything in
# their dir. Loopback-only (127.0.0.1:3109); the memory services reach it
# over ai.network as http://systemd-embeddings:8080/v1.
# Auth: the shared llama.cpp key (config/llama-cpp/keys.txt).
# No GPU: -ngl 0 (pure CPU), no AddDevice, no CUDA_VISIBLE_DEVICES.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Embeddings - llama.cpp server (CPU, bge-m3)
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/embeddings.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-embeddings
Image=ghcr.io/ggml-org/llama.cpp@sha256:9fbaa06d7f4449e2ae0d02b40e0431f7c212dcf231c9e3a7777a6afc2cc8f312
Network=ai.network
UserNS=keep-id
PublishPort=127.0.0.1:3109:8080/tcp
Volume=%h/.local/share/ai-lab/embeddings/models:/models:ro,Z
Volume=%h/.config/containers/config/llama-cpp/keys.txt:/etc/llama-cpp/keys.txt:ro

Environment=LLAMA_ARG_MODEL=/models/bge-m3-q8_0.gguf
Environment=LLAMA_ARG_MODEL_ALIAS=bge-m3
Environment=LLAMA_ARG_EMBEDDINGS=true
Environment=LLAMA_ARG_API_KEY_FILE=/etc/llama-cpp/keys.txt
Environment=LLAMA_ARG_HOST=0.0.0.0
Environment=LLAMA_ARG_PORT=8080
Environment=LLAMA_ARG_CTX_SIZE=8192
# llama.cpp default physical batch (512) 500-errors any single embedding
# input over 512 tokens ("increase the physical batch size", verified live
# 2026-11-04 via LightRAG PGVector flush). Raise to the logical batch size:
# pure-CPU bge-m3 with 8192 ctx - memory delta is one 2048-token ubatch.
Environment=LLAMA_ARG_UBATCH=2048
Environment=LLAMA_ARG_N_GPU_LAYERS=0
# bge-m3 pooled embeddings (dense retrieval for OpenViking + Honcho).
Environment=LLAMA_ARG_POOLING_TYPE=LAST
Environment=LLAMA_ARG_NORMALIZE=true

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60
# No install section by design: on-demand only (ai-lab convention).
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-embeddings
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-embeddings
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-embeddings --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v %h/.local/share/ai-lab/embeddings/models:/models:ro,Z -v %h/.config/containers/config/llama-cpp/keys.txt:/etc/llama-cpp/keys.txt:ro --publish 127.0.0.1:3109:8080/tcp --env LLAMA_ARG_API_KEY_FILE=/etc/llama-cpp/keys.txt --env LLAMA_ARG_CTX_SIZE=8192 --env LLAMA_ARG_EMBEDDINGS=true --env LLAMA_ARG_HOST=0.0.0.0 --env LLAMA_ARG_MODEL=/models/bge-m3-q8_0.gguf --env LLAMA_ARG_MODEL_ALIAS=bge-m3 --env LLAMA_ARG_NORMALIZE=true --env LLAMA_ARG_N_GPU_LAYERS=0 --env LLAMA_ARG_POOLING_TYPE=LAST --env LLAMA_ARG_PORT=8080 --env LLAMA_ARG_UBATCH=2048 ghcr.io/ggml-org/llama.cpp@sha256:9fbaa06d7f4449e2ae0d02b40e0431f7c212dcf231c9e3a7777a6afc2cc8f312
