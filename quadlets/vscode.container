[Unit]
Description=VS Code Server - Arch dev box (serve-web), host-podman aware
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-vscode
Image=localhost/vscode:1.144.1
Network=ai.network
UserNS=keep-id

# GPU: full card visibility via CDI (nvidia-smi/CUDA work inside) but NO
# registry "gpu" field -> the arbiter never treats this as a card claim.
# Both cards visible; pin per process with CUDA_VISIBLE_DEVICES when needed.
# Matches the test's GPU_DEVICE_OK exception (add "vscode" to the set).
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true

EnvironmentFile=%h/.config/containers/config/vscode/service.env

# persistent home (extensions, .vscode-server, dotfiles)
Volume=%h/.homes/vscode/px:/home/px:Z
# Box workspace: host ~/.workspaces/vscode mounted at ~/workspace INSIDE the
# container (matches the ~/workspace/<git-host>/<owner>/<repo> convention in
# the box's own shell; deliberately NOT the host's syncthing-synced ~/workspace
# tree -- v0.5, 2026-11-03; remap to ~/workspace, 2026-11-04).
# NOTE: the guest podman talks to the HOST daemon, so bind-mount SOURCES from
# the box are resolved on the host: use $HOME/.workspaces/vscode/... for box
# workspace files (not the container's ~/workspace path).
Volume=%h/.workspaces/vscode:/home/px/workspace:Z
# distrobox-style host Podman API (socket at the host's same path; the image
# sets containers.conf remote=true and the entrypoint registers the default
# connection -- no XDG_RUNTIME_DIR=/run/user/1000 override: the mount point
# is root-owned inside and the client needs a writable runtime dir)
Volume=%t/podman/podman.sock:/run/user/1000/podman/podman.sock

# Loopback-only publish. serve-web binds 0.0.0.0 INSIDE, so containers on
# ai.network can also reach it -- every request (from any surface) must carry
# the connection token ("a secret that must be included with all requests",
# serve-web --help; delivered via --connection-token-file in the entrypoint),
# so the ai.network reach is token-gated.
PublishPort=127.0.0.1:3113:8000/tcp

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
# first start downloads the VS Code Server component into the home
TimeoutStartSec=900
TimeoutStopSec=120
