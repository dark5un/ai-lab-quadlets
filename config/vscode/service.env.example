# generated on-target by the secrets flow (same pattern as sketchlab/hermes)
VSCODE_CONNECTION_TOKEN=change-me-to-a-random-hex-string
# STRATA_API_KEY is copied by generate-secrets.sh from
# config/strata/service.env (same pattern as sketchlab's AI proxy); never
# commit the real key. It reaches the strata-provider extension via the
# server environment (no user-scope config files are written anymore;
# see docs/copilot-strata.md).
STRATA_API_KEY=

