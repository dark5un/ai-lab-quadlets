# llama.cpp router settings - RTX 4070 Ti 12 GB.
# The installer copies this to ~/.config/containers/config/llama-cpp-4070ti/service.env
# when that file is missing; edit the deployed copy, not this example.

# Router model discovery
LLAMA_ARG_MODELS_DIR=/models
LLAMA_ARG_MODELS_MAX=1
LLAMA_ARG_MODELS_AUTOLOAD=true
LLAMA_ARG_MODELS_PRESET=/etc/llama-cpp/presets.ini
LLAMA_ARG_LOAD_MODE=none

# Auth: every request needs a key from the shared keys.txt
LLAMA_ARG_API_KEY_FILE=/etc/llama-cpp/keys.txt

# Server
LLAMA_ARG_HOST=0.0.0.0
LLAMA_ARG_PORT=8080

# Context
LLAMA_ARG_CTX_SIZE=65536
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_N_PREDICT=-1

# GPU - only this card is visible to the container
LLAMA_ARG_N_GPU_LAYERS=all
LLAMA_ARG_SPLIT_MODE=none
LLAMA_ARG_MAIN_GPU=0
LLAMA_ARG_KV_OFFLOAD=true
LLAMA_ARG_FLASH_ATTN=on

# KV cache
LLAMA_ARG_CACHE_TYPE_K=q4_0
LLAMA_ARG_CACHE_TYPE_V=q4_0

# Prompt processing
LLAMA_ARG_BATCH=512
LLAMA_ARG_UBATCH=128

# Do not silently reduce the requested context
LLAMA_ARG_FIT=off

# Chat templates and tool calling
LLAMA_ARG_JINJA=true

# Observability
LLAMA_ARG_ENDPOINT_METRICS=true
LLAMA_ARG_ENDPOINT_SLOTS=true
LLAMA_ARG_TIMEOUT=3600
LLAMA_ARG_SSE_PING_INTERVAL=30
