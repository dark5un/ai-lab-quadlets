# Forgejo runtime env — generated on-target (config/forge/service.env, 0600).
# Values here live ONLY on the host; git ships placeholders (agentic-pipeline plan).
# The tailnet FQDN placeholder <tailnet> is filled by generate-secrets.sh from
# `tailscale status --json` (Self.DNSName); DB credentials mirror
# config/forge/postgres.env (stack mirror rule).
FORGEJO__server__ROOT_URL=https://forge.<tailnet>
FORGEJO__server__DOMAIN=forge.<tailnet>
FORGEJO__server__SSH_DOMAIN=<node-tailnet-fqdn>
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__security__SECRET_KEY=change-me-to-a-random-hex-string
FORGEJO__database__HOST=systemd-forge-pg:5432
FORGEJO__database__NAME=forgejo
FORGEJO__database__USER=forgejo
FORGEJO__database__PASSWD=change-me-to-a-random-hex-string
# admin bootstrap (used by scripts/pipeline-bootstrap.sh via
# `forgejo admin user create`; DISABLE_REGISTRATION is on, no web signup)
FORGEJO_ADMIN_USER=pipeline
FORGEJO_ADMIN_PASSWORD=change-me-to-another-random-hex-string
