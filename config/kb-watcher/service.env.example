# kb-watcher runtime config. Secrets parts are generated by
# scripts/generate-secrets.sh (ENCRYPTION placeholder); RAGFLOW_API_KEY is a
# PAT created inside RAGFlow (Settings -> API) by scripts/kb-bootstrap.sh and
# written back here automatically. Endpoints are ai.network aliases.
RAGFLOW_BASE_URL=http://systemd-ragflow:9380
RAGFLOW_API_KEY=
LIGHTRAG_BASE_URL=http://systemd-lightrag:9621
# mirrored from config/lightrag/service.env (scripts/kb-lightrag-auth.py)
LIGHTRAG_API_KEY=
# KB LLM slot (classification calls, cheap JSON mode) runs on the
# llama-cpp-4070ti router (official Gemma 4 12B-it QAT); key copied by
# generate-secrets.sh from config/llama-cpp/keys.txt. STRATA_* kept as
# deprecated fallback names.
KB_LLM_BASE_URL=http://systemd-llama-cpp-4070ti:8080/v1
KB_LLM_API_KEY=
KB_LLM_MODEL=gemma-4-12b-it-qat-q4_0
STRATA_BASE_URL=http://systemd-strata:8080/v1
STRATA_API_KEY=
STRATA_MODEL=qwen3.8-flash-next-iq3_s
# corpus roots (mounted at identical host paths in the quadlet)
# corpus root: dedicated configurable folder (owner directive 2026-11-05:
# no pre-existing server files are corpus; ~/KB for now, move by env later)
CORPUS_ROOT=/home/px/KB
# optional additional root, empty = not scanned
CORPUS_ROOT_2=
KB_STATE_DIR=/home/px/workspace/github.com/dark5un/ai-lab-quadlets/kb
# completion hook -> Windmill W1 (in-network alias, plan sec.6);
# WM_API_TOKEN filled by generate-secrets from
# config/windmill/agent-token, passed as ?token= query arg)
WM_WEBHOOK_URL=http://systemd-windmill-server:8000/api/w/kb/jobs/run/p/f/kb/w1_discrepancy
WM_API_TOKEN=
# per-run ingest budget; the backlog drains across nightly passes
INGEST_LIMIT=3000
