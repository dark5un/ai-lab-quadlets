# concourse-mcp server env — generated on-target (config/concourse/mcp.env,
# 0600; agentic-pipeline plan sec. 7). Two static bearer tokens, each mapped
# by the server to a Concourse local user/team credential (never shared):
#   MCP_TOKEN_HERMES   -> team pipeline (full toolset)   [Hermes on the host]
#   MCP_TOKEN_PIPELINE -> team agent    (read/trigger set) [in-pipeline tasks]
# The Concourse passwords are mirrored from web.env by generate-secrets.sh.
MCP_PORT=8080
CONCOURSE_ATC_URL=http://systemd-concourse-web:8080
MCP_TOKEN_HERMES=change-me-to-a-random-hex-string
CONCOURSE_USER=pipeline
CONCOURSE_PASSWORD=change-me-to-a-second-random-hex-string
MCP_TOKEN_PIPELINE=change-me-to-another-random-hex-string
CONCOURSE_LOWPRIV_USER=agent
CONCOURSE_LOWPRIV_PASSWORD=change-me-to-a-third-random-hex-string
