# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# Shared notebook server (windmill-jupyter plan P2): JupyterLab + marimo on
# one port, kernels CPU-light (no GPU fields - CUDA experiments belong to the
# dev boxes). Notebooks live in ~/workspace/notebooks (own git repo, mounted
# at the SAME host path - same-path trick for direct agent/owner edits).
# Auth: ServerApp.token_file (file generated by generate-secrets.sh at
# config/notebook/jupyter-token, mounted ro). Loopback 3118; tailnet door
# planned: Tailscale Service svc:notebook. Platform env (KB_ROUTER_URL/KEY,
# RAGFLOW/LIGHTRAG/WM) in config/notebook/service.env (600).
# VS Code boxes attach with kernel-picker 'Existing Jupyter Server' ->
# http://systemd-notebook:8888/?token=... (or the door URL), single source of
# truth for kernels/state per owner decision.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Notebook server (JupyterLab + marimo, CPU-only)
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/notebook.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-notebook
Image=localhost/notebook:latest
Network=ai.network
UserNS=keep-id
PublishPort=127.0.0.1:3118:8888/tcp
EnvironmentFile=%h/.config/containers/config/notebook/service.env
Volume=%h/workspace/notebooks:/home/px/workspace/notebooks
Volume=notebook-state:/home/jovyan/.jupyter
Volume=%h/.config/containers/config/notebook/jupyter-token:/run/jupyter/token:ro,Z
Volume=%h/.config/containers/config/notebook/jupyter_server_config.py:/home/jovyan/.jupyter/jupyter_server_config.py:ro,Z
# docker-stacks entrypoint passthrough. NOTE: --ServerApp.token_file is
# shadowed by the stacks' self-minted token (verified live) - the pinned
# token comes from the mounted jupyter_server_config.py instead.
Exec=/usr/local/bin/start-notebook.py --ServerApp.ip=0.0.0.0 --ServerApp.root_dir=/home/px/workspace/notebooks --ServerApp.default_url=/lab --ServerApp.allow_remote_access=True

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=60
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-notebook
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-notebook
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-notebook --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v %h/workspace/notebooks:/home/px/workspace/notebooks -v notebook-state:/home/jovyan/.jupyter -v %h/.config/containers/config/notebook/jupyter-token:/run/jupyter/token:ro,Z -v %h/.config/containers/config/notebook/jupyter_server_config.py:/home/jovyan/.jupyter/jupyter_server_config.py:ro,Z --publish 127.0.0.1:3118:8888/tcp --env-file %h/.config/containers/config/notebook/service.env localhost/notebook:latest /usr/local/bin/start-notebook.py --ServerApp.ip=0.0.0.0 --ServerApp.root_dir=/home/px/workspace/notebooks --ServerApp.default_url=/lab --ServerApp.allow_remote_access=True
