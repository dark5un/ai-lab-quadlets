[Unit]
Description=Open WebUI
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-open-webui
Image=ghcr.io/open-webui/open-webui:v0.11.3
Network=ai.network
PublishPort=0.0.0.0:3100:8080/tcp
Volume=open-webui-data:/app/backend/data
EnvironmentFile=%h/.config/containers/config/open-webui/service.env

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
