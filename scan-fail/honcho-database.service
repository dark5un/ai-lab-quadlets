# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# Honcho database - PostgreSQL 15 + pgvector (required by Honcho; the plain
# postgres image lacks the extension). NO host port on purpose: reachable
# only on ai.network as systemd-honcho-database:5432. POSTGRES_PASSWORD (and
# Honcho's DB_CONNECTION_URI) live in config/honcho/service.env (600);
# honcho-api / honcho-deriver read the same file.
# Start BEFORE honcho-api (migrations run on honcho-api's first start).

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Honcho database (PostgreSQL 15 + pgvector)
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/honcho-database.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-honcho-database
Image=docker.io/pgvector/pgvector@sha256:47af0b65960b14f1c6945aa4ccae37836c632e9a6fe0eea9160936e616e5b2e9
Network=ai.network
UserNS=keep-id
Environment=POSTGRES_DB=honcho
Environment=POSTGRES_USER=honcho
EnvironmentFile=%h/.config/containers/config/honcho/service.env
Volume=%h/.local/share/ai-lab/honcho-database:/var/lib/postgresql/data:Z

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
# No install section by design: on-demand only (ai-lab convention).
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-honcho-database
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-honcho-database
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-honcho-database --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v %h/.local/share/ai-lab/honcho-database:/var/lib/postgresql/data:Z --env POSTGRES_DB=honcho --env POSTGRES_USER=honcho --env-file %h/.config/containers/config/honcho/service.env docker.io/pgvector/pgvector@sha256:47af0b65960b14f1c6945aa4ccae37836c632e9a6fe0eea9160936e616e5b2e9
