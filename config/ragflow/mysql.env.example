# Env for the ragflow-mysql SERVER only (kept apart from service.env because
# the mysql entrypoint aborts on MYSQL_USER=root; service.env carries that for
# the RAGFlow client). generate-secrets.sh mirrors the value of MYSQL_PASSWORD
# from config/ragflow/service.env into MYSQL_ROOT_PASSWORD here.
MYSQL_ROOT_PASSWORD=change-me-to-another-random-hex-string
