[Unit]
Description=Hermes Agent web and Telegram service
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-hermes-gateway
Image=docker.io/nousresearch/hermes-agent:latest
Network=ai.network
PublishPort=0.0.0.0:3104:9119/tcp
UserNS=keep-id
User=0
EnvironmentFile=%h/.config/containers/config/hermes-service/service.env
Volume=%h/.local/share/hermes-service:/opt/data:Z
ShmSize=1g
Exec=gateway run

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=120
MemoryMax=4G
CPUQuota=200%
