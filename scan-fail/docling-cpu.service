# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# docling-serve (CPU) — document conversion API behind the docling MCP.
# Group "docling": one variant at a time (cpu / 4070ti share the container
# name and host port 3108; Conflicts= keeps one). No [Install]: on demand via
# `ai-lab docling cpu|4070ti|off` or the AI Lab bar widget.
# Loopback-only (127.0.0.1:3108): the host's docling MCP is the only client;
# no new exposure. ~/Documents is mounted read-only for conversions.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=docling-serve (CPU)
Wants=ai-network.service
After=ai-network.service
Conflicts=docling-4070ti.service
SourcePath=/home/px/.config/containers/systemd/docling-cpu.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-docling
Image=quay.io/docling-project/docling-serve-cpu@sha256:225c8586e20d5d0fc6811a9e0e044fa602bcc4393f00389009bad42d6787b58f
# The app runs as PID 1 and ignores SIGTERM; catatonit forwards it.
RunInit=true
Network=ai.network
PublishPort=127.0.0.1:3108:5001/tcp
# Model weights land in the image user's cache: HF_HOME defaults to
# /opt/app-root/src/.cache/huggingface and DOCLING_SERVE_ARTIFACTS_PATH is
# /opt/app-root/src/.cache/docling/models (Containerfile). One named volume
# covers both, so conversions after the first download need no network.
Volume=docling-hf:/opt/app-root/src/.cache
Volume=%h/Documents:/mnt/documents:ro
Environment=DOCLING_SERVE_ENABLE_UI=1
# The sync convert endpoints give up after DOCLING_SERVE_MAX_SYNC_WAIT
# (default 120 s); big RPG books need far more. Batch clients wait on their
# own side, so raise the server cap.
Environment=DOCLING_SERVE_MAX_SYNC_WAIT=3600
# 1 pipeline worker + CPU pinning: docling's OCR stage runs on CPU providers
# and 4 workers pushed the package to 105C (crit). Pin to the 8 E-cores via
# taskset (the cpuset cgroup controller is not delegated to the user slice,
# so --cpuset-cpus fails; strata-coder pins the same way): strata's 5090
# variants never use those cores, and the arbiter never runs the coder and
# docling-4070ti at once. --cpus=4: half the E-core cluster, the 8-CPU quota still hit 89C.
Environment=DOCLING_SERVE_ENG_LOC_NUM_WORKERS=1
Entrypoint=/usr/bin/taskset
Exec=-c 16-23 container-entrypoint docling-serve run
PodmanArgs=--cpus=4

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-docling
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-docling
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-docling --replace --rm --cgroups=split --entrypoint=/usr/bin/taskset --init --network systemd-ai --sdnotify=conmon -d -v docling-hf:/opt/app-root/src/.cache -v %h/Documents:/mnt/documents:ro --publish 127.0.0.1:3108:5001/tcp --env DOCLING_SERVE_ENABLE_UI=1 --env DOCLING_SERVE_ENG_LOC_NUM_WORKERS=1 --env DOCLING_SERVE_MAX_SYNC_WAIT=3600 --cpus=4 quay.io/docling-project/docling-serve-cpu@sha256:225c8586e20d5d0fc6811a9e0e044fa602bcc4393f00389009bad42d6787b58f -c 16-23 container-entrypoint docling-serve run
