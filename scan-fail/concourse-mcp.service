Image=localhost/concourse-mcp:latest
Network=ai.network
EnvironmentFile=%h/.config/containers/config/concourse/mcp.env
PublishPort=127.0.0.1:3123:8080/tcp

# in-network only beyond loopback: task containers reach :8080 via aardvark

[Service]
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-concourse-mcp
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-concourse-mcp
