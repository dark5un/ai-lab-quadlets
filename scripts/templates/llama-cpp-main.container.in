# GPU llama.cpp quadlet — GENERATED by scripts/detect-gpus.sh
# This file is re-generated on each install. Do not edit directly.
# Edit the template in scripts/templates/llama-cpp-main.container.in instead.

[Unit]
Description=llama.cpp {GPU_NAME} long-context router
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=llama-cpp-main
Image=ghcr.io/ggml-org/llama.cpp:server-cuda

# GPU assignment: {GPU_NAME} ({GPU_VRAM} GB)
AddDevice=nvidia.com/gpu={GPU_UUID}
SecurityLabelDisable=true

# Keep container user mapped to host user for volume access.
UserNS=keep-id

Network=ai.network

# Native host clients:
# http://127.0.0.1:11435/v1
PublishPort=0.0.0.0:11435:8080

# Shared read-only model library.
Volume=%h/.local/share/llama.cpp/models:/models:ro,Z

# Per-model preset config.
Volume=%h/.config/containers/config/llama.cpp/presets.ini:/etc/llama-cpp/presets.ini:ro

# Api keys.
Volume=%h/.config/containers/config/llama.cpp/keys.txt:/etc/llama-cpp/keys.txt:ro

EnvironmentFile=%h/.config/containers/config/llama.cpp/service.env

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=1800
TimeoutStopSec=120
MemoryMax={MEMORY_MAX}G

[Install]
WantedBy=default.target