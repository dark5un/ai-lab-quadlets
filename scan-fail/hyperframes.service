# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=HyperFrames Render Server
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/hyperframes.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-hyperframes
# Build from HyperFrames repo:
#   cd ~/workspace/github.com/heygen-com/hyperframes && \
#   podman build -f packages/gcp-cloud-run/Dockerfile \
#     -t localhost/hyperframes:latest .
Image=localhost/hyperframes:latest
# The app runs as PID 1 and ignores SIGTERM; catatonit forwards it.
RunInit=true
Network=ai.network
PublishPort=0.0.0.0:3103:8080/tcp
# Mount compositions from host for rendering
Volume=hyperframes-compositions:/project/compositions:Z
Volume=hyperframes-output:/project/output:Z
Environment=PORT=8080

# Software rendering (no GPU needed for headless Chrome)
# If GPU acceleration desired, add: AddDevice=nvidia.com/gpu=all

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=60
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-hyperframes
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-hyperframes
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-hyperframes --replace --rm --cgroups=split --init --network systemd-ai --sdnotify=conmon -d -v hyperframes-compositions:/project/compositions:Z -v hyperframes-output:/project/output:Z --publish 0.0.0.0:3103:8080/tcp --env PORT=8080 localhost/hyperframes:latest
