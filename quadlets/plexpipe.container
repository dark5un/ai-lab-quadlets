# plexpipe: MaxPresence P0 door service (docs/mac-virtual-devices-plan.md).
# One Mac session at a time; JSON control + binary 'A'/'V' tags. Talks to
# systemd-personaplex:8998 and systemd-max-bridge:8990 over ai.network;
# loopback publish 8991 for the tailnet WSS door (tailscale serve :8457).
# CPU-only. Dials plex/bridge lazily per session and retries — start order
# is free (personaplex is on-demand with its own 4070 Ti VRAM budget).
# NOTE: personaplex must be up before a P0/P1 gate test can round-trip.

[Unit]
Description=MaxPresence plexpipe audio door (Mac <-> personaplex <-> bridge)
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-plexpipe
Image=localhost/plexpipe:latest
Network=ai.network
PublishPort=127.0.0.1:8991:8991/tcp
# same persona as the max-headroom app (apps/max-headroom/src/main2.js PERSONA)
# persona per owner directive 2026-11-12 (facts #35/#36): Maximilian, 1970s
# scientist, British voice (pxvoice.wav = piper ryan-high). Headroom wording
# retired; owner can re-word, keep replies short.
Environment=PLEX_TEXT_PROMPT="You are Maximilian: a curious, warm-hearted scientist from the 1970s with a British manner of speaking. You converse as an equal participant — one or two crisp sentences per turn, questions when intrigued, no assistant talk, no TV catchphrases."
Environment=MAXVID_URL=ws://systemd-maxvid:8992/frames
# ticket 07: learned-face renderer feed + its PCM tap (skin switch at the door)
Environment=MAXFACE_URL=ws://systemd-maxface:8993/frames
Environment=MAXFACE_AUDIO_URL=ws://systemd-maxface:8993/audio-in

[Service]
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# No [Install] section by design: opt-in via ai-lab (avatar group, boot=false).
