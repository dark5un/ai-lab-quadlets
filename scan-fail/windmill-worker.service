# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# Windmill worker - executes jobs (MODE=worker, WORKER_GROUP=default).
# Same image as the server. Single trusted operator today: bare-container
# sandbox (DISABLE_NSJAIL default true = nsjail OFF; the plan's
# 'ENABLE_NSJAIL=false' is not a real var) and NO privileged - the compose
# privileged+unshare shape is PID-namespace hardening we skip until the
# team arrives (revisit per plan P3). CPU-only: no GPU fields.
# Job scratch + dependency cache live under /tmp/windmill (compose mounts
# worker_logs:/tmp/windmill/logs + cache:/tmp/windmill/cache).

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Windmill worker (default group)
Wants=ai-network.service
Wants=windmill-postgres.service
After=ai-network.service
After=windmill-postgres.service
SourcePath=/home/px/.config/containers/systemd/windmill-worker.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-windmill-worker
Image=ghcr.io/windmill-labs/windmill:1.862.0
Network=ai.network
UserNS=keep-id
Environment=MODE=worker
Environment=WORKER_GROUP=default
# NO NATIVE_MODE here (verified the hard way 2026-11-05: a native-mode worker
# refuses DEPENDENCY jobs - python lock/dependency resolution silently fails
# ("Worker is in native mode and cannot execute dependency jobs"), scripts
# never land, run endpoints 404). The compose 'native' group is a separate
# dedicated worker for native TRIGGER jobs; single trusted-operator setup
# keeps one default worker; add a native worker only if trigger scale needs it.
Environment=SLEEP_QUEUE=200
Environment=HOME=/tmp
EnvironmentFile=%h/.config/containers/config/windmill/service.env
Volume=wm-worker-cache:/tmp/windmill/cache

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-windmill-worker
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-windmill-worker
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-windmill-worker --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v wm-worker-cache:/tmp/windmill/cache --env HOME=/tmp --env MODE=worker --env SLEEP_QUEUE=200 --env WORKER_GROUP=default --env-file %h/.config/containers/config/windmill/service.env ghcr.io/windmill-labs/windmill:1.862.0
