{
	# mkcert-issued cert, keyed pre-substitution to HOSTNAME.local by install.sh.
	# When mkcert is unavailable, install.sh falls back to Caddy's internal
	# CA and rewrites the site blocks back to "tls internal".
	auto_https disable_redirects
}

https://HOSTNAME.local:3001 {
	tls /etc/caddy/certs/HOSTNAME.local.pem /etc/caddy/certs/HOSTNAME.local-key.pem

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy systemd-open-webui:8080
}

https://HOSTNAME.local:3002 {
	tls /etc/caddy/certs/HOSTNAME.local.pem /etc/caddy/certs/HOSTNAME.local-key.pem

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy systemd-comfyui:8188
}

https://HOSTNAME.local:3003 {
	tls /etc/caddy/certs/HOSTNAME.local.pem /etc/caddy/certs/HOSTNAME.local-key.pem

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy systemd-hermes-gateway:9119
}

