[Unit]
Description=Sketchlab - diagramming SPA with save/load backend
After=ai-network.service


[Container]
ContainerName=systemd-sketchlab
Image=localhost/sketchlab:v0.5.0
Network=ai.network
PublishPort=0.0.0.0:3102:8080/tcp
UserNS=keep-id
Volume=%h/.local/share/sketchlab:/data:Z

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=default.target