# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# Knowledge-base PostgreSQL - pgvector 0.8 on PostgreSQL 18 (LightRAG's docs
# name this image as sufficient for PGTableGraphStorage + PGVectorStorage).
# Same family as honcho-database but a SEPARATE instance: deliberate blast-
# radius split (plan R5), honcho's data must never sit next to the corpus
# graph. NO host port: reachable only as systemd-kb-postgres:5432.
# POSTGRES_* live in config/kb-postgres/service.env (600); lightrag's copy of
# the password is mirrored there by generate-secrets.sh.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Knowledge-base PostgreSQL (pgvector) for LightRAG
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/kb-postgres.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-kb-postgres
Image=docker.io/pgvector/pgvector:pg18
Network=ai.network
UserNS=keep-id
EnvironmentFile=%h/.config/containers/config/kb-postgres/service.env
# PG 18 official images store data in major-version-specific dirs
# (/var/lib/postgresql/18/docker) - mount the PARENT (docker-library/postgres#1259),
# not .../data which older images (honcho's pg15) used.
Volume=kb-lightrag-pg-data:/var/lib/postgresql

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-kb-postgres
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-kb-postgres
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-kb-postgres --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d --userns keep-id -v kb-lightrag-pg-data:/var/lib/postgresql --env-file %h/.config/containers/config/kb-postgres/service.env docker.io/pgvector/pgvector:pg18
