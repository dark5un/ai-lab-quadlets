# Generated service env (from .example templates) — ** matches any depth
config/**/service.env
config/**/presets.ini
config/**/keys.txt
config/**/.deepseek-harness-built

# Built VSIX (release artifacts, never committed)
*.vsix

# OS junk
.DS_Store
Thumbs.db

# Editor swap files
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc

# KB group (knowledge-base plan): corpus-derived state lives in the project
# but is NEVER committed - the repo is public and this content quotes the
# private ~/workspace + ~/Documents corpus. Only kb/README.md is tracked.
kb/reports/
kb/manifest.json
kb/watcher-errors.json
kb/state/
kb/workflows/
kb/fixtures/
# local build artifacts (built via `go build` in tools/kbsearch)
tools/kbsearch/kbsearch

# Node app artifacts
node_modules/
dist/

# max-call probe artifacts & logs (contain meeting links)
apps/max-call/artifacts/*.png
apps/max-call/*.log
apps/artifacts/
