# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# node-exporter (monitoring tier, boot). Host CPU/RAM/disk/net/temp.
# Network=host like deepseek-harness: it binds 127.0.0.1:9100 itself, so
# it stays off the LAN. Rootless with Pid=host sees hwmon, pressure,
# filesystem and cpu (verified 2026-10-08); node_systemd_unit_state needs
# dbus and is absent — acceptable (podman-exporter covers the stack).

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Prometheus node exporter (host metrics)
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/node-exporter.container
RequiresMountsFor=%t/containers
RequiresMountsFor=/

[X-Container]
ContainerName=systemd-node-exporter
Image=quay.io/prometheus/node-exporter@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0
Network=host
Volume=/:/host:ro,rslave
Volume=%h/.local/share/node-exporter/textfile:/textfile:z
# The image defaults to USER nobody, which cannot read the 700 textfile
# dir (owned by px; container root maps to px rootless). Run as root.
PodmanArgs=--pid=host --user=0
# Exec appends to the image entrypoint (/bin/node_exporter): flags only.
Exec=--path.rootfs=/host --collector.textfile.directory=/textfile

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-node-exporter
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-node-exporter
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-node-exporter --replace --rm --cgroups=split --network host --sdnotify=conmon -d -v /:/host:ro,rslave -v %h/.local/share/node-exporter/textfile:/textfile:z --pid=host --user=0 quay.io/prometheus/node-exporter@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0 --path.rootfs=/host --collector.textfile.directory=/textfile

[Install]
WantedBy=default.target
