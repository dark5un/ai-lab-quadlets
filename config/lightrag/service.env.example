# Generated on-target by scripts/generate-secrets.sh. Consumed by
# lightrag.container. Model ids are EXACT ids from the endpoints' /v1/models
# (stack pitfall: a mismatched id misidentifies the model). Endpoints are
# ai.network aliases, never host loopback.
PORT=9621
# required once the UI/API leaves loopback (tailscale serve); generated +
# mirrored into kb-watcher/service.env by scripts/kb-lightrag-auth.py
LIGHTRAG_API_KEY=
HOST=0.0.0.0

# --- LLM: strata (verified id live 2026-11-04) ---
LLM_BINDING=openai
LLM_BINDING_HOST=http://systemd-strata:8080/v1
LLM_MODEL=qwen3.8-flash-next-iq3_s
# filled by generate-secrets.sh from config/strata/service.env API_KEY
LLM_BINDING_API_KEY=
# Extraction/keyword roles: strata is a thinking model; with thinking ON one
# extraction call burns >12k tokens of hidden reasoning, hits finish=length
# (truncated JSON) and blows LightRAG's worker timeout (2*LLM_TIMEOUT=480s
# by default) - all mirrored docs failed with "Worker execution timeout
# after 480s" (verified live 2026-11-04). reasoning_effort=none is honored
# by the llama.cpp server: same call drops to ~22s with finish=stop.
# Env pattern {ROLE}_OPENAI_LLM_{FIELD} verified against v1.5.7
# binding_options.options_dict_for_role (roles: extract/keyword/query/vlm).
EXTRACT_OPENAI_LLM_REASONING_EFFORT=none
KEYWORD_OPENAI_LLM_REASONING_EFFORT=none
# headroom for the single-slot 1M strata under MAX_ASYNC=4 queueing
LLM_TIMEOUT=600

# --- embeddings: bge-m3 (dense 1024; dim is FROZEN at table creation) ---
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=http://systemd-embeddings:8080/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=1024
EMBEDDING_SEND_DIM=false
# filled by generate-secrets.sh from config/llama-cpp/keys.txt
EMBEDDING_BINDING_API_KEY=

# --- storage: all four backends on kb-postgres (PGTableGraphStorage = plain
# tables + JSONB, no AGE extension -> Cloud SQL compatible, per plan R5) ---
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
POSTGRES_HOST=systemd-kb-postgres
POSTGRES_PORT=5432
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=change-me-to-a-random-hex-string
POSTGRES_DATABASE=lightrag

# inputs are pushed by kb-watcher (stable path+hash ids); keep staging local
INPUT_DIR=/app/data/inputs
RAG_STORAGE_DIR=/app/data/storage
