# Rizzo Flow — local Jev-compatible System One decisions (llama.cpp)
# Port 11437 (1143x model-API family, docs/port-plan.md).
# Rendered by scripts/render-units.sh (4070 Ti UUID filled in from nvidia-smi).
# GPU: fixed to the 4070 Ti, pinned at the CUDA layer (CUDA_VISIBLE_DEVICES),
# the stack's convention for non-strata services. Start it through `ai-lab
# start rizzo` or the AI Lab bar widget so scripts/gpu-arbiter.py moves strata
# off the 4070 Ti first. No [Install]: nothing starts at boot.

[Unit]
Description=Rizzo Flow System One decision server (4070 Ti)
Wants=ai-network.service
After=ai-network.service

[Container]
ContainerName=systemd-rizzo
Image=localhost/rizzo-flow:4b-q8_0
Network=ai.network
AddDevice=nvidia.com/gpu=all
Environment=CUDA_VISIBLE_DEVICES=__GPU_4070TI_UUID__
SecurityLabelDisable=true
UserNS=keep-id

# Jev-compatible endpoint: POST http://<host>:11437/v1/systemone
# Playground: http://<host>:11437/playground
PublishPort=0.0.0.0:11437:8017

# Optional calibration files (rizzo calibrate -> fit.json, then add
# --calibration /data/fit.json to Exec below once fitted on your own data).
Volume=%h/.local/share/rizzo:/data:Z

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
TimeoutStopSec=60
MemoryMax=16G
