# DeepSeek Harness settings template — preset OpenAI-compatible connections.
# Copy to ~/.local/share/deepseek-harness/settings.yaml and adjust.
# Provider routes point at the local ai-lab-quadlets model servers; API keys
# are resolved from the container environment (env vars listed in
# ~/.config/containers/config/deepseek-harness/service.env, mode 600).
# Context windows default to 262144 (262k) per operator preference.
llm-pi-ai:
  providers:
    strata:
      displayName: Strata (RTX 5090)
      api: openai-completions
      baseURL: http://127.0.0.1:11434/v1
      apiKeyEnv: STRATA_API_KEY
      defaultContextWindow: 262144
      models:
        - id: qwen3.8-flash-next-iq3_s
          name: Qwen3.8 Flash next IQ3_S
          contextWindow: 262144
          maxTokens: 32768
          input: [text]
          reasoningEfforts: false
    # A hand-declared route MUST list at least one model or dsh refuses the
    # WHOLE llm-pi-ai section at boot ("resolves no models"). The llama.cpp
    # router serves whatever GGUFs are in ~/.local/share/llama.cpp/models;
    # with none loaded there is nothing to declare, so the route stays
    # commented out. When a model is loaded, uncomment and list its id
    # (check `curl http://127.0.0.1:11435/v1/models`).
    # llama-cpp:
    #   displayName: llama.cpp router (11435)
    #   api: openai-completions
    #   baseURL: http://127.0.0.1:11435/v1
    #   apiKeyEnv: LLAMA_CPP_API_KEY
    #   defaultContextWindow: 262144
    #   models:
    #     - id: <model id served by /v1/models>
    #       contextWindow: 262144
