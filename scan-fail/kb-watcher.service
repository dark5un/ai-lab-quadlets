# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# corpus-watcher (plan section 4): nightly one-shot ingestion pass over
# the dedicated corpus folder (CORPUS_ROOT env; ~/KB for now). sha256 manifest diff -> push added/changed docs
# to RAGFlow (+ mirror into LightRAG), tombstone deletions, write reports
# under <repo>/kb/. Started by kb-watcher.timer (nightly) or manually via
# `systemctl --user start kb-watcher.service`.
# Wants= wakes the whole KB group on demand; the deps then stay up.
# Corpus root mounts at its HOST path (same-path rule) read-only; the kb/
# state dir gets its own rw mount (owner directive 2026-11-05: only the
# dedicated corpus folder is scanned - no pre-existing server files).

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=Knowledge-base corpus watcher (one-shot ingestion pass)
Wants=ai-network.service
Wants=ragflow.service
Wants=lightrag.service
Wants=embeddings.service
After=ai-network.service
After=ragflow.service
After=lightrag.service
After=embeddings.service
SourcePath=/home/px/.config/containers/systemd/kb-watcher.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-kb-watcher
Image=localhost/kb-watcher:latest
Network=ai.network
UserNS=keep-id
EnvironmentFile=%h/.config/containers/config/kb-watcher/service.env
Volume=%h/KB:/home/px/KB:ro
Volume=%h/workspace/github.com/dark5un/ai-lab-quadlets/kb:/home/px/workspace/github.com/dark5un/ai-lab-quadlets/kb

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Type=oneshot
# First full pass over the corpus is long: allow 6h (timer re-arms once the
# unit goes inactive either way - no RemainAfterExit).
TimeoutStartSec=21600
TimeoutStopSec=120
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-kb-watcher
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-kb-watcher
Delegate=yes
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-kb-watcher --replace --rm --cgroups=split --network systemd-ai --userns keep-id -v %h/KB:/home/px/KB:ro -v %h/workspace/github.com/dark5un/ai-lab-quadlets/kb:/home/px/workspace/github.com/dark5un/ai-lab-quadlets/kb --env-file %h/.config/containers/config/kb-watcher/service.env localhost/kb-watcher:latest
