# Automatically generated by /usr/lib/systemd/user-generators/podman-user-generator
# 
# VictoriaLogs (monitoring tier, boot). Log store fed by fluent-bit;
# chosen over Loki in the 2026-10-08 bake-off (VictoriaLogs+Fluent Bit
# worked with zero tuning; Loki needed a world-writable data dir, raised
# ingestion limits, and Alloy's journal labels needed a relabel stage).
# Retention 30 days capped at 5 GB (plan D6). No host port: Grafana
# reaches it as http://systemd-victorialogs:9428 on ai.network.

[Unit]
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
Description=VictoriaLogs (ai-lab log store)
Wants=ai-network.service
After=ai-network.service
SourcePath=/home/px/.config/containers/systemd/victorialogs.container
RequiresMountsFor=%t/containers
Requires=ai-network.service
After=ai-network.service

[X-Container]
ContainerName=systemd-victorialogs
Image=docker.io/victoriametrics/victoria-logs@sha256:251121fa882af99b95ba0c230a4a2f412ea602d2698c64a96c58dc9842bb755d
Network=ai.network
# loopback only: Grafana reaches it as systemd-victorialogs:9428 on ai.network;
# the published port exists for curl debugging.
PublishPort=127.0.0.1:9428:9428/tcp
Volume=%h/.local/share/victorialogs:/vlogs-storage:z
# Exec appends to the image entrypoint (/victoria-logs-prod): flags only.
Exec=-storageDataPath=/vlogs-storage -retentionPeriod=30d -retention.maxDiskSpaceUsageBytes=5GiB

[Service]
# A container killed by the stop signal exits 143; that is a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
Environment=PODMAN_SYSTEMD_UNIT=%n
KillMode=mixed
ExecStop=/usr/bin/podman rm -v -f -i systemd-victorialogs
ExecStopPost=-/usr/bin/podman rm -v -f -i systemd-victorialogs
Delegate=yes
Type=notify
NotifyAccess=all
SyslogIdentifier=%N
ExecStart=/usr/bin/podman run --name systemd-victorialogs --replace --rm --cgroups=split --network systemd-ai --sdnotify=conmon -d -v %h/.local/share/victorialogs:/vlogs-storage:z --publish 127.0.0.1:9428:9428/tcp docker.io/victoriametrics/victoria-logs@sha256:251121fa882af99b95ba0c230a4a2f412ea602d2698c64a96c58dc9842bb755d -storageDataPath=/vlogs-storage -retentionPeriod=30d -retention.maxDiskSpaceUsageBytes=5GiB

[Install]
WantedBy=default.target
