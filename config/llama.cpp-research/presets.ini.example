# llama.cpp per-model presets — secondary GPU (smaller VRAM e.g. 12 GB)
# Generated by scripts/detect-gpus.sh
# Based on: {GPU_NAME} ({GPU_VRAM} GB)

version = 1

; Global defaults for smaller VRAM GPU
[*]
ctx-size = {DEFAULT_CTX}
n-predict = -1
n-gpu-layers = all
split-mode = none
main-gpu = 0
kv-offload = true
flash-attn = on
cache-type-k = {CACHE_K}
cache-type-v = {CACHE_V}
fit = off
jinja = on
load-mode = mmap

; Smaller-context models (fits in limited VRAM)
;[model-name]
;m = /models/path/to/model.gguf
;ctx-size = 16384
;temp = 0.7
;top-p = 0.95