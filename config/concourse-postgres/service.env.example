# Concourse ATC PostgreSQL server env — generated on-target
# (config/concourse-postgres/service.env, 600; agentic-pipeline plan).
# Consumed by the postgres image entrypoint only (keep foreign vars OUT).
# DB/user name atc = Concourse's documented default (running-postgres doc).
# The password copy inside concourse/web.env is mirrored by generate-secrets.sh.
POSTGRES_DB=atc
POSTGRES_USER=atc
POSTGRES_PASSWORD=change-me-to-a-random-hex-string
