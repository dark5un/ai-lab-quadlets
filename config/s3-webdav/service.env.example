# s3-webdav service env — rclone serve webdav over the Garage buckets.
# The GARAGE_* key pair is MIRRORED from s3/service.env (GARAGE_KEY_ID /
# GARAGE_SECRET) by scripts/generate-secrets.sh — same pattern as the
# concourse credential mirrors. The webdav login itself lives in the
# generated htpasswd file (apr1); the plaintext mirror here is for the
# owner's convenience (Finder/Cyberduck), never in argv or unit files.
S3_WEBDAV_USER=webdav
S3_WEBDAV_PASSWORD=change-me-to-a-random-hex-string
RCLONE_CONFIG_GARAGE_TYPE=s3
RCLONE_CONFIG_GARAGE_PROVIDER=Other
RCLONE_CONFIG_GARAGE_ENDPOINT=http://systemd-s3:3900
RCLONE_CONFIG_GARAGE_REGION=garage   # SigV4 scope must match garage.toml s3_region
RCLONE_CONFIG_GARAGE_ACCESS_KEY_ID=
RCLONE_CONFIG_GARAGE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_GARAGE_ENV_AUTH=false
RCLONE_CONFIG_GARAGE_FORCE_PATH_STYLE=true
