# ailab-api: bearer token for the tailnet-only control API door.
# scripts/generate-secrets.sh replaces the placeholders (rand_hex 32 each).
AILAB_API_TOKEN=change-me-to-a-random-hex-string
# vscode-pr review-button backend (docs/vscode-pr-review-plan.md): HMAC key
# for the signed launch/access links. pipeline-bootstrap.sh mirrors it into
# pipeline-vars.yml as vscode-pr-signing-secret (the repo-review agent
# computes button signatures with it) and fills the other VSCODE_PR_*
# wiring keys (Concourse/Forgejo/box-ssh) idempotently.
VSCODE_PR_SIGNING_SECRET=change-me-to-a-second-random-hex-string
