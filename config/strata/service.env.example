# Strata settings shared by strata-5090 / strata-4070ti / strata-both.
# install-strata.sh creates service.env (mode 600) with a random API_KEY; do
# not commit that file. Per-variant settings (GPU/GPUS, CONTEXT, KV) are
# Environment= lines in each unit, not here.
FAMILY=qwen
MODEL=IQ3_S
VISION=no
LOW_RAM=auto
API_KEY=
