# Windmill server+worker shared env - generated from this example by
# scripts/generate-secrets.sh (mode 600). The password inside DATABASE_URL
# is MIRRORED from config/windmill-postgres/service.env by the generator
# (one secret, two files - stack pattern).
# Endpoint is the ai.network alias (containers never use host loopback).
DATABASE_URL=postgresql://postgres:change-me-to-a-random-hex-string@systemd-windmill-postgres:5432/windmill?sslmode=disable
# Public base URL of this instance (webhook/app links shown in UI).
# Swap to the svc:windmill tailnet door URL when the door is created.
BASE_URL=http://127.0.0.1:3117
# Bearer token acting as virtual superadmin superadmin@windmill.dev -
# used by scripts/windmill-bootstrap.sh for headless account+workspace setup.
SUPERADMIN_SECRET=change-me-to-another-random-hex-string
